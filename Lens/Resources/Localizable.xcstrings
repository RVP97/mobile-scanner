        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbasan baharu tidak disimpan. Anda boleh mengaktifkannya dalam Seting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye skanninger lagres ikke. Du kan slå dette på i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe scans worden niet bewaard. Je kunt dit inschakelen bij Instellingen."
