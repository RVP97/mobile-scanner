    "Pass details are sent to Lunet's signing service to create your pass. Nothing is stored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُرسَل تفاصيل البطاقة إلى خدمة التوقيع في Lunet لإنشاء بطاقتك. لا يتم تخزين أي شيء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dades del passi s’envien al servei de signatura de Lunet per crear-lo. No es desa res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje karty se odesílají do podpisové služby Lunetu, aby se karta mohla vytvořit. Nic se neukládá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortoplysningerne sendes til Lunets signeringstjeneste for at oprette dit kort. Intet gemmes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pass-Details werden an den Signierdienst von Lunet gesendet, um deinen Pass zu erstellen. Es wird nichts gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα στοιχεία του πάσου αποστέλλονται στην υπηρεσία υπογραφής του Lunet για τη δημιουργία του πάσου σας. Τίποτα δεν αποθηκεύεται."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass details are sent to Lunet's signing service to create your pass. Nothing is stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos del pase se envían al servicio de firma de Lunet para crear tu pase. No se guarda nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortin tiedot lähetetään Lunetin allekirjoituspalveluun kortin luomista varten. Mitään ei tallenneta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les détails du pass sont envoyés au service de signature de Lunet pour créer votre pass. Rien n’est stocké."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרטי הכרטיס נשלחים לשירות החתימה של Lunet כדי ליצור את הכרטיס שלך. שום דבר לא נשמר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पास बनाने के लिए पास का विवरण Lunet की साइनिंग सर्विस को भेजा जाता है। कुछ भी स्टोर नहीं किया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaci o propusnici šalju se Lunetovoj usluzi potpisivanja radi izrade propusnice. Ništa se ne pohranjuje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kártya adatait a Lunet aláíró szolgáltatása kapja meg a kártya létrehozásához. Semmi sem tárolódik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detail pass dikirim ke layanan penandatanganan Lunet untuk membuat pass Anda. Tidak ada yang disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dettagli del pass vengono inviati al servizio di firma di Lunet per creare il pass. Nulla viene archiviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスを作成するため、パスの詳細がLunetの署名サービスに送信されます。何も保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패스를 생성하기 위해 패스 정보가 Lunet의 서명 서비스로 전송됩니다. 아무것도 저장되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butiran pas dihantar ke perkhidmatan tandatangan Lunet untuk mencipta pas anda. Tiada apa-apa disimpan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortdetaljene sendes til Lunets signeringstjeneste for å opprette kortet ditt. Ingenting lagres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gegevens van de pas worden naar de ondertekeningsdienst van Lunet gestuurd om je pas aan te maken. Er wordt niets opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dane przepustki są wysyłane do usługi podpisywania Lunet, aby utworzyć przepustkę. Nic nie jest przechowywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do passe são enviados ao serviço de assinatura do Lunet para criar o seu passe. Nada é armazenado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados do passe são enviados para o serviço de assinatura da Lunet para criar o passe. Nada é guardado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaliile permisului sunt trimise serviciului de semnare Lunet pentru a crea permisul. Nimic nu este stocat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные карты отправляются в службу подписи Lunet для ее создания. Ничего не сохраняется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Údaje karty sa odošlú do podpisovej služby Lunetu na vytvorenie vašej karty. Nič sa neukladá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kortuppgifterna skickas till Lunets signeringstjänst för att skapa ditt kort. Inget lagras."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายละเอียดบัตรจะถูกส่งไปยังบริการลงนามของ Lunet เพื่อสร้างบัตรของคุณ ไม่มีข้อมูลใดถูกเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartınızı oluşturmak için kart ayrıntıları Lunet’in imzalama hizmetine gönderilir. Hiçbir şey saklanmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дані картки надсилаються до служби підпису Lunet для її створення. Нічого не зберігається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông tin thẻ được gửi đến dịch vụ ký của Lunet để tạo thẻ của bạn. Không có gì được lưu trữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卡券详细信息会发送到 Lunet 的签名服务以创建你的卡券。不会存储任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "票卡資料會傳送到 Lunet 的簽署服務以建立你的票卡。不會儲存任何資料。"
          }
        }
      }
    },
