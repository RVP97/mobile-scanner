    "Still scans with %lld%% of it covered or scuffed. Print it %@ or larger." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظل قابلًا للمسح حتى مع تغطية %1$lld%% منه أو خدشه. اطبعه بحجم %2$@ أو أكبر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara s’escaneja amb el %1$lld%% tapat o ratllat. Imprimeix-lo a %2$@ o més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenuje se, i když je %1$lld%% kódu zakryto nebo poškrábáno. Vytiskněte ho ve velikosti %2$@ nebo větší."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan scannes, selv når %1$lld%% er dækket eller ridset. Udskriv den i %2$@ eller større."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannt noch, wenn %1$lld %% davon verdeckt oder zerkratzt sind. Drucke ihn in %2$@ oder größer."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σαρώνεται ακόμα και με το %1$lld%% καλυμμένο ή φθαρμένο. Εκτυπώστε τον σε %2$@ ή μεγαλύτερο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Still scans with %1$lld%% of it covered or scuffed. Print it %2$@ or larger."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still scans with %1$lld%% of it covered or scuffed. Print it %2$@ or larger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sigue escaneando aunque el %1$lld%% esté cubierto o raspado. Imprímelo a %2$@ o más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skannautuu, vaikka %1$lld %% siitä olisi peitossa tai kulunut. Tulosta se kokoon %2$@ tai suuremmaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste lisible même abîmé ou masqué à %1$lld %%. Imprimez-le en %2$@ minimum."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדיין נסרק גם כש־%1$lld%% ממנו מכוסה או שרוט. הדפס אותו בגודל %2$@ או יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld%% हिस्सा ढका या घिसा होने पर भी स्कैन होता है। इसे %2$@ या उससे बड़ा प्रिंट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skenira se i kad je %1$lld%% prekriveno ili izgrebeno. Ispišite ga u veličini %2$@ ili većoj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akkor is beolvasható, ha %1$lld%%-a le van takarva vagy kopott. Nyomtassa legalább %2$@ méretben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetap terpindai meski %1$lld%% bagiannya tertutup atau tergores. Cetak dengan ukuran %2$@ atau lebih besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si scansiona anche con il %1$lld%% coperto o graffiato. Stampalo a %2$@ o più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld%%が隠れたり擦れたりしても読み取れます。%2$@以上の大きさで印刷してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld%%가 가려지거나 긁혀도 스캔됩니다. %2$@ 이상의 크기로 인쇄하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih boleh diimbas walaupun %1$lld%% daripadanya dilindungi atau tercalar. Cetak pada saiz %2$@ atau lebih besar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan fortsatt skannes med %1$lld %% dekket til eller slitt. Skriv den ut i %2$@ eller større."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scant nog als %1$lld%% ervan bedekt of beschadigd is. Druk hem af op %2$@ of groter."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal się skanuje, gdy %1$lld%% kodu jest zasłonięte lub porysowane. Wydrukuj go w rozmiarze %2$@ lub większym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua legível mesmo com %1$lld%% coberto ou riscado. Imprima com %2$@ ou mais."
