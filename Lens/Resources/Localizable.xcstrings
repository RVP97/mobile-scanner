    "Anyone who scans this joins without typing the password." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي شخص يمسح هذا الرمز ينضم دون كتابة كلمة السر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
