          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ GTIN ที่กำหนดให้กับสินค้าของคุณ ไม่ต้องใส่หลักสุดท้าย แล้ว Lunet จะเพิ่มเลขตรวจสอบให้"
