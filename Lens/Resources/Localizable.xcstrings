    "Touch and hold an empty spot, then tap Add a Control." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس مطولًا مكانًا فارغًا، ثم اضغط على «إضافة عنصر تحكم»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén premut un espai buit i toca Afegeix un control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte prst na prázdném místě a klepněte na Přidat ovládací prvek."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på et tomt sted, og tryk derefter på Tilføj et betjeningselement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege Stelle gedrückt halten und dann auf „Steuerelement hinzufügen“ tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε παρατεταμένα ένα κενό σημείο και μετά αγγίξτε «Προσθήκη χειριστηρίου»."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold an empty spot, then tap Add a Control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionado un espacio vacío y toca Agregar un control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina tyhjää kohtaa pitkään ja napauta sitten Lisää säädin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur un espace vide, puis touchez Ajouter une commande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גע במקום ריק והחזק, ואז הקש על ״הוסף פקד״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी खाली जगह को दबाकर रखें, फिर “नियंत्रण जोड़ें” पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite i držite prazno mjesto, zatim dodirnite Dodaj kontrolu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa megérintve egy üres területet, majd koppintson a Vezérlő hozzáadása elemre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan area kosong, lalu ketuk Tambah Kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto uno spazio vuoto, poi tocca Aggiungi un controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空いている場所を長押しして、「コントロールを追加」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 공간을 길게 터치한 다음 제어 항목 추가를 탭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan ruang kosong, kemudian ketik Tambah Kawalan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på et tomt område, og trykk deretter på Legg til en kontroll."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je vinger op een lege plek en tik dan op ‘Voeg een bedieningselement toe’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij i przytrzymaj puste miejsce, a następnie stuknij w Dodaj narzędzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionado um espaço vazio e toque em Adicionar um Controle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premido um espaço vazio e toque em Adicionar um controlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingeți lung un spațiu gol, apoi apăsați pe Adăugați o comandă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь пустого места и удерживайте, затем коснитесь «Добавить элемент управления»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte prst na prázdnom mieste a ťuknite na Pridať ovládací prvok."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned på en tom plats och tryck sedan på Lägg till ett reglage."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะพื้นที่ว่างค้างไว้ แล้วแตะ “เพิ่มตัวควบคุม”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boş bir yere dokunup basılı tutun, sonra Denetim Ekle’ye dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться й утримуйте порожнє місце, а потім торкніться «Додати елемент керування»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và giữ vào một chỗ trống, rồi chạm vào Thêm điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住空白处，然后轻点“添加控制”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住空白處，然後點一下「加入控制項目」。"
          }
        }
      }
    },
    "Touch and hold the Home Screen, then tap Edit › Add Widget." : {
      "localizations" : {
        "ar" : {
