    "This UPC-A number has too few zeros to shorten into UPC-E. Use UPC-A instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي رقم UPC-A هذا على عدد قليل جدًا من الأصفار لاختصاره إلى UPC-E. استخدم UPC-A بدلًا منه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest número UPC-A té massa pocs zeros per escurçar-lo a UPC-E. Fes servir UPC-A."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto číslo UPC-A má příliš málo nul na zkrácení na UPC-E. Použijte UPC-A."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette UPC-A-nummer har for få nuller til at blive forkortet til UPC-E. Brug UPC-A i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese UPC-A-Nummer hat zu wenige Nullen, um sie zu UPC-E zu kürzen. Verwende stattdessen UPC-A."
