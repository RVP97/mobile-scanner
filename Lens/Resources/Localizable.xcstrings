    "The fastest scan is the one where you never look for the app. Put Lunet where your thumb already is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسرع مسح هو الذي لا تبحث فيه عن التطبيق أبدًا. ضع Lunet حيث يوجد إبهامك بالفعل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’escaneig més ràpid és aquell en què no has de buscar l’app. Posa Lunet on ja tens el polze."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejrychlejší skenování je to, při kterém aplikaci vůbec nehledáte. Dejte Lunet tam, kde už máte palec."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hurtigste scanning er den, hvor du aldrig skal lede efter appen. Placer Lunet, hvor din tommelfinger allerede er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am schnellsten scannst du, wenn du die App nie suchen musst. Platziere Lunet dort, wo dein Daumen schon ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η ταχύτερη σάρωση είναι αυτή όπου δεν ψάχνετε ποτέ την εφαρμογή. Βάλτε το Lunet εκεί όπου βρίσκεται ήδη ο αντίχειράς σας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The fastest scan is the one where you never look for the app. Put Lunet where your thumb already is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escaneo más rápido es el que no te obliga a buscar la app. Pon Lunet donde ya está tu pulgar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopein skannaus on se, jossa appia ei tarvitse etsiä. Pidä Lunet siellä, missä peukalosi jo on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scan le plus rapide, c’est celui où l’on ne cherche pas l’app. Placez Lunet là où se trouve déjà votre pouce."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסריקה המהירה ביותר היא זו שבה לא צריך לחפש את היישום. שים את Lunet במקום שבו האגודל שלך כבר נמצא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे तेज़ स्कैन वह है जिसमें आपको ऐप ढूँढना ही न पड़े। Lunet को वहाँ रखें जहाँ आपका अंगूठा पहले से होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najbrže je skeniranje ono kad aplikaciju uopće ne tražite. Stavite Lunet ondje gdje vam je već palac."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A leggyorsabb beolvasás az, amelyhez nem kell az appot keresni. Tegye a Lunetet oda, ahol a hüvelykujja amúgy is van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemindaian tercepat adalah saat Anda tidak perlu mencari app-nya. Letakkan Lunet di tempat jempol Anda sudah berada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scansione più veloce è quella in cui non devi cercare l’app. Metti Lunet dove c’è già il tuo pollice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いちばん速いスキャンは、アプリを探さずに済むスキャンです。Lunetを親指がすぐ届く場所に置きましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 빠른 스캔은 앱을 찾을 필요가 없는 스캔입니다. 엄지손가락이 닿는 곳에 Lunet을 두십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imbasan terpantas ialah imbasan yang anda tidak perlu mencari apl. Letakkan Lunet di tempat ibu jari anda sudah berada."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den raskeste skanningen er den der du aldri leter etter appen. Plasser Lunet der tommelen din allerede er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De snelste scan is die waarbij je nooit naar de app hoeft te zoeken. Zet Lunet waar je duim al is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najszybszy skan to taki, przy którym nie szukasz aplikacji. Umieść Lunet tam, gdzie już jest Twój kciuk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O escaneamento mais rápido é aquele em que você nem procura o app. Coloque o Lunet onde seu polegar já está."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A leitura mais rápida é aquela em que nem procura a app. Coloque a Lunet onde o seu polegar já está."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cea mai rapidă scanare este cea în care nu căutați aplicația. Puneți Lunet acolo unde vă este deja degetul mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самое быстрое сканирование — то, для которого не нужно искать приложение. Разместите Lunet там, где уже ваш палец."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najrýchlejší sken je ten, pri ktorom aplikáciu nehľadáte. Dajte Lunet tam, kde už máte palec."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den snabbaste skanningen är den där du aldrig letar efter appen. Placera Lunet där tummen redan är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสแกนที่เร็วที่สุดคือการสแกนที่คุณไม่ต้องมองหาแอป วาง Lunet ไว้ตรงที่นิ้วโป้งของคุณอยู่แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En hızlı tarama, uygulamayı hiç aramadığınız taramadır. Lunet’i başparmağınızın zaten olduğu yere koyun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Найшвидше сканування — те, для якого не треба шукати програму. Розмістіть Lunet там, де вже ваш палець."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lần quét nhanh nhất là khi bạn không cần tìm ứng dụng. Hãy đặt Lunet ngay chỗ ngón cái của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最快的扫描，是无需寻找 App 的扫描。把 Lunet 放在拇指随手可及的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最快的掃描，就是不必找 App 的掃描。把 Lunet 放在你拇指隨手可及的地方。"
          }
        }
      }
    },
    "The last digit should be %lld — it's the check digit." : {
      "localizations" : {
