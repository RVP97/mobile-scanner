        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the Lock Screen, then tap Customise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén presionada la pantalla bloqueada y toca Personalizar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paina lukittua näyttöä pitkään ja napauta sitten Muokkaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur l’écran verrouillé, puis touchez Personnaliser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גע במסך הנעילה והחזק, ואז הקש על ״התאם אישית״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लॉक स्क्रीन को दबाकर रखें, फिर “कस्टमाइज़ करें” पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite i držite zaključani zaslon, zatim dodirnite Prilagodi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartsa megérintve a zárolási képernyőt, majd koppintson a Testreszabás gombra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan Layar Terkunci, lalu ketuk Sesuaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto sulla schermata di blocco, poi tocca Personalizza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面を長押しして、「カスタマイズ」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면을 길게 터치한 다음 사용자화를 탭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan Skrin Kunci, kemudian ketik Suaikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk og hold på Låst skjerm, og trykk deretter på Tilpass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je vinger op het toegangsscherm en tik dan op ‘Pas aan’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij i przytrzymaj ekran blokady, a następnie stuknij w Dostosuj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionada a Tela Bloqueada e toque em Personalizar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha premido o ecrã bloqueado e toque em Personalizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atingeți lung ecranul de blocare, apoi apăsați pe Personalizați."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь экрана блокировки и удерживайте, затем коснитесь «Настроить»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podržte prst na zamknutej obrazovke a ťuknite na Prispôsobiť."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned på låsskärmen och tryck sedan på Anpassa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะหน้าจอล็อคค้างไว้ แล้วแตะ “กำหนดเอง”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilitli Ekran’a dokunup basılı tutun, sonra Özelleştir’e dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Торкніться й утримуйте замкнений екран, а потім торкніться «Налаштувати»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm và giữ Màn hình khóa, rồi chạm vào Tùy chỉnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住锁定屏幕，然后轻点“自定”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住鎖定畫面，然後點一下「自訂」。"
          }
        }
      }
    },
