            "value" : "Llisca cap avall i toca Escaneja."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejeďte dolů a klepněte na Skenovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub nedad, og tryk på Scan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach unten streichen, auf „Scannen“ tippen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε προς τα κάτω, αγγίξτε «Σάρωση»."
