    "Guests point their camera and they’re on. No spelling out passwords." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوجّه الضيوف الكاميرا فيتصلون فورًا. دون تهجئة كلمات السر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els convidats apunten amb la càmera i ja estan connectats. Sense haver de lletrejar contrasenyes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hosté namíří fotoaparát a jsou připojení. Žádné hláskování hesel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gæsterne peger kameraet mod koden og er på. Ingen stavning af adgangskoder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäste richten die Kamera darauf und sind verbunden. Kein Buchstabieren von Passwörtern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επισκέπτες στρέφουν την κάμερα και συνδέονται. Χωρίς να συλλαβίζετε κωδικούς."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guests point their camera and they’re on. No spelling out passwords."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus invitados apuntan la cámara y listo. Sin deletrear contraseñas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vieraat osoittavat kameralla ja ovat verkossa. Salasanoja ei tarvitse tavata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos invités pointent l’appareil photo et c’est fait. Plus besoin d’épeler le mot de passe."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "האורחים מכוונים את המצלמה ומתחברים. בלי להכתיב סיסמאות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेहमान बस कैमरा पॉइंट करते हैं और कनेक्ट हो जाते हैं। पासवर्ड बोल-बोलकर बताने की ज़रूरत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gosti usmjere kameru i već su spojeni. Bez sricanja lozinki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A vendégek ráirányítják a kamerát, és már csatlakoztak is. Nem kell jelszót betűzni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamu cukup mengarahkan kamera dan langsung tersambung. Tak perlu mengeja kata sandi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli ospiti inquadrano con la fotocamera e sono connessi. Niente password da dettare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストはカメラを向けるだけで接続完了。パスワードを読み上げる必要はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손님은 카메라만 갖다 대면 바로 연결됩니다. 암호를 불러줄 필요가 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tetamu hanya halakan kamera dan terus bersambung. Tidak perlu mengeja kata laluan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjestene retter kameraet mot koden og er tilkoblet. Ingen staving av passord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasten richten hun camera erop en ze zijn verbonden. Geen wachtwoorden meer spellen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goście kierują aparat na kod i już są połączeni. Bez literowania haseł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os convidados apontam a câmera e pronto, já estão conectados. Nada de soletrar senhas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os convidados apontam a câmara e ficam logo ligados. Sem soletrar palavras-passe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitații îndreaptă camera spre cod și sunt conectați. Fără să dictați parole."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гости наводят камеру — и уже в сети. Не нужно диктовать пароли."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hostia namieria kameru a sú pripojení. Žiadne hláskovanie hesiel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gästerna riktar kameran mot koden och är uppkopplade. Inget stavande av lösenord."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แขกแค่หันกล้องมาก็เชื่อมต่อได้ทันที ไม่ต้องสะกดรหัสผ่านให้ฟัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuklar kameralarını tutar ve bağlanır. Parolaları tek tek söylemeye gerek yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гості наводять камеру — і вже в мережі. Не треба диктувати паролі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khách chỉ cần hướng camera là kết nối được. Không phải đánh vần mật khẩu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "访客只需用相机对准即可连接，无需逐字念出密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪客只要用相機對準就能連上，不必逐字念出密碼。"
          }
        }
      }
    },
