    "Lunet has no account and no tracking. We never see what you scan, create or where you are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتطلب Lunet حسابًا ولا يتتبعك. لا نرى أبدًا ما تمسحه أو تنشئه أو مكان وجودك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet no té comptes ni seguiment. No veiem mai què escaneges, què crees ni on ets."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet nemá účet ani sledování. Nikdy nevidíme, co skenujete, vytváříte ani kde jste."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet har ingen konto og ingen sporing. Vi ser aldrig, hvad du scanner, opretter, eller hvor du er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet hat kein Konto und kein Tracking. Wir sehen nie, was du scannst oder erstellst oder wo du bist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lunet δεν έχει λογαριασμό ούτε παρακολούθηση. Δεν βλέπουμε ποτέ τι σαρώνετε, τι δημιουργείτε ή πού βρίσκεστε."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet has no account and no tracking. We never see what you scan, create or where you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet no tiene cuentas ni rastreo. Nunca vemos lo que escaneas, lo que creas ni dónde estás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunetissa ei ole tiliä eikä seurantaa. Emme koskaan näe, mitä skannaat tai luot tai missä olet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet n’a ni compte ni suivi. Nous ne voyons jamais ce que vous scannez, ce que vous créez, ni où vous êtes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב־Lunet אין חשבון ואין מעקב. אנחנו לעולם לא רואים מה אתה סורק, יוצר או איפה אתה נמצא."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet में न कोई अकाउंट है, न ट्रैकिंग। आप क्या स्कैन करते हैं, क्या बनाते हैं या कहाँ हैं, यह हम कभी नहीं देखते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet nema račun ni praćenje. Nikad ne vidimo što skenirate, što izrađujete ni gdje se nalazite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lunethez nem kell fiók, és nincs követés. Soha nem látjuk, mit olvas be, mit hoz létre, és hol van."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet tidak memiliki akun dan tidak melacak. Kami tidak pernah melihat apa yang Anda pindai, buat, atau di mana Anda berada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet non ha account né tracciamento. Non vediamo mai cosa scansioni, cosa crei o dove ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
