    "Times are saved in universal time, so they show correctly in any time zone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم حفظ الأوقات بالتوقيت العالمي، لذا تظهر بشكل صحيح في أي منطقة زمنية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les hores es desen en temps universal, així que es mostren bé en qualsevol fus horari."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časy se ukládají v koordinovaném světovém čase, takže se správně zobrazí v každém časovém pásmu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidspunkter gemmes i universel tid, så de vises korrekt i alle tidszoner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeiten werden in Weltzeit gesichert und daher in jeder Zeitzone korrekt angezeigt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ώρες αποθηκεύονται σε παγκόσμια ώρα, ώστε να εμφανίζονται σωστά σε κάθε ζώνη ώρας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times are saved in universal time, so they show correctly in any time zone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas se guardan en hora universal, así que se muestran bien en cualquier zona horaria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajat tallennetaan UTC-aikana, joten ne näkyvät oikein kaikilla aikavyöhykkeillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures sont enregistrées en temps universel pour s’afficher correctement dans tous les fuseaux horaires."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השעות נשמרות בזמן אוניברסלי, כך שהן מוצגות נכון בכל אזור זמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय यूनिवर्सल टाइम में सहेजे जाते हैं, इसलिए वे किसी भी टाइम ज़ोन में सही दिखते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vremena se spremaju u univerzalnom vremenu pa se ispravno prikazuju u bilo kojoj vremenskoj zoni."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az időpontok egyezményes világidőben tárolódnak, így bármely időzónában helyesen jelennek meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu disimpan dalam waktu universal, sehingga tampil dengan benar di zona waktu mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli orari sono salvati in tempo universale, così appaiono corretti in qualsiasi fuso orario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻は協定世界時で保存されるため、どのタイムゾーンでも正しく表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간은 협정 세계시로 저장되므로 모든 시간대에서 올바르게 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masa disimpan dalam waktu universal, jadi ia dipaparkan dengan betul dalam mana-mana zon waktu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klokkeslett lagres i universell tid, så de vises riktig i alle tidssoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijden worden in universele tijd bewaard, zodat ze in elke tijdzone juist worden weergegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godziny są zapisywane w czasie uniwersalnym, więc wyświetlają się poprawnie w każdej strefie czasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os horários são salvos em tempo universal, então aparecem corretamente em qualquer fuso horário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As horas são guardadas em tempo universal, por isso aparecem corretamente em qualquer fuso horário."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orele sunt salvate în timp universal, deci apar corect în orice fus orar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время сохраняется по UTC, поэтому корректно отображается в любом часовом поясе."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Časy sa ukladajú v koordinovanom svetovom čase, takže sa správne zobrazia v akomkoľvek časovom pásme."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tider sparas i universell tid, så de visas rätt i alla tidszoner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลาจะถูกบันทึกเป็นเวลาสากล จึงแสดงได้ถูกต้องในทุกเขตเวลา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saatler evrensel saatle kaydedilir, böylece her saat diliminde doğru görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час зберігається за UTC, тому правильно відображається в будь-якому часовому поясі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian được lưu theo giờ quốc tế, nên hiển thị đúng ở mọi múi giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间以协调世界时存储，因此在任何时区都能正确显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間以世界標準時間儲存，因此在任何時區都能正確顯示。"
          }
        }
      }
    },
