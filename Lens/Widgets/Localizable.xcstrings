        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nasbírejte několik kódů za sebou a pak je projděte najednou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saml flere koder i træk, og gennemse dem derefter samlet."
