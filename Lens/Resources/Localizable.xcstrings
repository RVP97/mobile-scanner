    "“.%@” addresses are often used for scams." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غالبًا ما تُستخدم عناوين «.%@» في عمليات الاحتيال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adreces «.%@» sovint es fan servir per a estafes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresy „.%@“ se často používají k podvodům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”.%@”-adresser bruges ofte til svindel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„.%@“-Adressen werden oft für Betrug verwendet."
