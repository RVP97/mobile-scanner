    "Require Face ID or your passcode before anyone can see your scans." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب Face ID أو رمز الدخول قبل أن يتمكن أي شخص من رؤية عمليات المسح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demana Face ID o el codi abans que ningú pugui veure els teus escaneigs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyžadovat Face ID nebo kód, než kdokoli uvidí vaše skenování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræv Face ID eller din adgangskode, før nogen kan se dine scanninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID oder deinen Code verlangen, bevor jemand deine Scans sehen kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απαιτήστε Face ID ή τον κωδικό σας πριν μπορέσει κάποιος να δει τις σαρώσεις σας."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require Face ID or your passcode before anyone can see your scans."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide Face ID o tu código antes de que alguien pueda ver tus escaneos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaadi Face ID tai pääsykoodi, ennen kuin kukaan näkee skannauksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exigez Face ID ou votre code avant que quiconque puisse voir vos scans."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דרוש Face ID או את קוד הגישה שלך לפני שמישהו יוכל לראות את הסריקות שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी के भी आपके स्कैन देख पाने से पहले Face ID या आपका पासकोड आवश्यक करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtijevajte Face ID ili šifru prije nego što itko može vidjeti vaša skeniranja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID vagy jelkód szükséges, mielőtt bárki megtekinthetné a beolvasásait."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wajibkan Face ID atau kode sandi Anda sebelum siapa pun dapat melihat pindaian Anda."
