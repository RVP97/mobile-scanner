    "Links can't contain spaces." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن أن تحتوي الروابط على مسافات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els enllaços no poden contenir espais."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkazy nesmí obsahovat mezery."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links kan ikke indeholde mellemrum."
