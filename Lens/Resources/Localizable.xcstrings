            "value" : "Le centre plein"
          }
        }
      }
    },
    "There's nothing to sign up for and nothing to sign in to." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada en qué registrarse ni nada en qué iniciar sesión."
