    "New scans aren’t saved. You can turn this on in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم حفظ عمليات المسح الجديدة. يمكنك تشغيل ذلك في الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els escaneigs nous no es desen. Pots activar-ho a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nová skenování se neukládají. Zapnout to můžete v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye scanninger gemmes ikke. Du kan slå det til i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Scans werden nicht gesichert. Du kannst dies in den Einstellungen aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι νέες σαρώσεις δεν αποθηκεύονται. Μπορείτε να το ενεργοποιήσετε στις Ρυθμίσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New scans aren’t saved. You can turn this on in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los escaneos nuevos no se guardan. Puedes activarlo en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uusia skannauksia ei tallenneta. Voit laittaa tämän päälle Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux scans ne sont pas enregistrés. Vous pouvez l’activer dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סריקות חדשות לא נשמרות. אפשר להפעיל זאת ב״הגדרות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए स्कैन सहेजे नहीं जाते। आप इसे सेटिंग्ज़ में चालू कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nova skeniranja ne spremaju se. To možete uključiti u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az új beolvasások nem mentődnek. Ezt a Beállításokban kapcsolhatja be."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindaian baru tidak disimpan. Anda dapat menyalakannya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove scansioni non vengono salvate. Puoi attivare questa opzione in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいスキャンは保存されません。設定でオンにできます。"
