        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un codi a Lunet i fixa’l aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvořte kód v Lunetu a připněte ho sem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en kode i Lunet, og fastgør den her."
          }
        },
