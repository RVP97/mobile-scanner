    "Lunet can only add images to your library. Turn on access in Settings to save codes there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Lunet إضافة الصور فقط إلى مكتبتك. شغّل الوصول في الإعدادات لحفظ الرموز فيها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet només pot afegir imatges a la fototeca. Activa l’accés a Configuració per desar-hi codis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet může do knihovny obrázky jen přidávat. Chcete‑li tam ukládat kódy, zapněte přístup v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet kan kun føje billeder til dit fotobibliotek. Slå adgang til i Indstillinger for at gemme koder der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet kann nur Bilder zu deiner Mediathek hinzufügen. Aktiviere den Zugriff in den Einstellungen, um Codes dort zu sichern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lunet μπορεί μόνο να προσθέτει εικόνες στη βιβλιοθήκη σας. Ενεργοποιήστε την πρόσβαση στις Ρυθμίσεις για να αποθηκεύετε κωδικούς εκεί."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet can only add images to your library. Turn on access in Settings to save codes there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet solo puede agregar imágenes a tu fototeca. Activa el acceso en Configuración para guardar códigos ahí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet voi vain lisätä kuvia kirjastoosi. Tallenna koodeja sinne sallimalla pääsy Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet peut seulement ajouter des images à votre photothèque. Activez l’accès dans Réglages pour y enregistrer des codes."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Lunet יכול רק להוסיף תמונות לספריה שלך. הפעל את הגישה ב״הגדרות״ כדי לשמור שם קודים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet आपकी लाइब्रेरी में सिर्फ़ इमेज जोड़ सकता है। वहाँ कोड सहेजने के लिए सेटिंग्ज़ में ऐक्सेस चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet može samo dodavati slike u vašu fototeku. Uključite pristup u Postavkama kako biste ondje spremali kodove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lunet csak képeket adhat a fotókönyvtárhoz. A kódok mentéséhez kapcsolja be a hozzáférést a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet hanya dapat menambahkan gambar ke perpustakaan Anda. Nyalakan akses di Pengaturan untuk menyimpan kode di sana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet può solo aggiungere immagini alla tua libreria. Attiva l’accesso in Impostazioni per salvarvi i codici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunetはライブラリへの画像の追加のみ可能です。コードを保存するには、設定でアクセスをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet은 사진 보관함에 이미지를 추가하는 것만 할 수 있습니다. 그곳에 코드를 저장하려면 설정에서 접근을 켜십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet hanya boleh menambah imej pada pustaka foto anda. Aktifkan akses dalam Seting untuk menyimpan kod di sana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet kan bare legge til bilder i biblioteket ditt. Slå på tilgang i Innstillinger for å lagre koder der."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet kan alleen afbeeldingen aan je bibliotheek toevoegen. Schakel toegang in bij Instellingen om codes daar te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet może tylko dodawać obrazki do biblioteki. Włącz dostęp w Ustawieniach, aby zachowywać tam kody."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lunet só pode adicionar imagens à sua fototeca. Ative o acesso em Ajustes para salvar códigos nela."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lunet só pode adicionar imagens à fototeca. Ative o acesso em Definições para guardar lá os códigos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet poate doar să adauge imagini în biblioteca dvs. Activați accesul în Configurări pentru a salva codurile acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet может только добавлять изображения в медиатеку. Включите доступ в Настройках, чтобы сохранять туда коды."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet môže do vašej fotoknižnice iba pridávať obrázky. Ak tam chcete ukladať kódy, zapnite prístup v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet kan bara lägga till bilder i ditt bildbibliotek. Aktivera åtkomst i Inställningar för att spara koder där."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet เพิ่มภาพลงในคลังของคุณได้เท่านั้น เปิดการเข้าถึงในการตั้งค่าเพื่อบันทึกโค้ดไว้ที่นั่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet yalnızca arşivinize görüntü ekleyebilir. Kodları oraya kaydetmek için Ayarlar’da erişimi açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet може лише додавати зображення до медіатеки. Увімкніть доступ у Параметрах, щоб зберігати туди коди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet chỉ có thể thêm hình ảnh vào thư viện của bạn. Hãy bật quyền truy cập trong Cài đặt để lưu mã vào đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet 只能向你的图库添加图像。请在设置中打开访问权限，以便将码存储到其中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet 只能將影像加入你的圖庫。請在「設定」中開啟取用權限，才能將條碼儲存到圖庫。"
          }
        }
      }
    },
