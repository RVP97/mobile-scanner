    "Deep check follows redirects and looks up the domain's age by contacting the link's own server. Nothing is sent to Lunet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتتبع الفحص المعمّق عمليات إعادة التوجيه ويتحقق من عمر النطاق عبر الاتصال بخادم الرابط نفسه. لا يُرسَل أي شيء إلى Lunet."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La comprovació a fons segueix les redireccions i consulta l’antiguitat del domini contactant el servidor del mateix enllaç. No s’envia res a Lunet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Důkladná kontrola sleduje přesměrování a zjišťuje stáří domény dotazem přímo na server odkazu. Nic se neodesílá do Lunetu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det grundige tjek følger omdirigeringer og slår domænets alder op ved at kontakte linkets egen server. Intet sendes til Lunet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gründliche Prüfung folgt Weiterleitungen und ermittelt das Alter der Domain, indem sie den Server des Links selbst kontaktiert. An Lunet wird nichts gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο εις βάθος έλεγχος ακολουθεί τις ανακατευθύνσεις και βρίσκει την ηλικία του τομέα επικοινωνώντας με τον ίδιο τον διακομιστή του συνδέσμου. Τίποτα δεν αποστέλλεται στο Lunet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep check follows redirects and looks up the domain's age by contacting the link's own server. Nothing is sent to Lunet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La verificación a fondo sigue las redirecciones y consulta la antigüedad del dominio contactando al propio servidor del enlace. No se envía nada a Lunet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perusteellinen tarkistus seuraa uudelleenohjauksia ja selvittää verkkotunnuksen iän ottamalla yhteyttä linkin omaan palvelimeen. Lunetille ei lähetetä mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification approfondie suit les redirections et consulte l’âge du domaine en contactant le serveur du lien lui-même. Rien n’est envoyé à Lunet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדיקה מעמיקה עוקבת אחר הפניות ובודקת את גיל הדומיין על ידי פנייה לשרת של הקישור עצמו. שום דבר לא נשלח אל Lunet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गहन जाँच रीडायरेक्ट को फ़ॉलो करती है और लिंक के अपने सर्वर से संपर्क करके डोमेन की उम्र पता करती है। Lunet को कुछ भी नहीं भेजा जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detaljna provjera prati preusmjeravanja i doznaje starost domene obraćajući se poslužitelju same poveznice. Ništa se ne šalje Lunetu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alapos ellenőrzés követi az átirányításokat, és a link saját szerverétől kérdezi le a domain korát. A Lunet semmit sem kap meg."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemeriksaan mendalam mengikuti pengalihan dan mencari tahu usia domain dengan menghubungi server milik tautan itu sendiri. Tidak ada yang dikirim ke Lunet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il controllo approfondito segue i reindirizzamenti e verifica l’età del dominio contattando il server del link stesso. Nulla viene inviato a Lunet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "詳細チェックでは、リンク先のサーバに直接問い合わせて、リダイレクトをたどり、ドメインの登録からの期間を調べます。Lunetには何も送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정밀 확인은 링크 자체의 서버에 연결하여 리디렉션을 추적하고 도메인 연령을 조회합니다. Lunet으로는 아무것도 전송되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semakan mendalam mengikut ubah hala dan menyemak usia domain dengan menghubungi pelayan pautan itu sendiri. Tiada apa-apa dihantar kepada Lunet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundig sjekk følger omdirigeringer og slår opp domenets alder ved å kontakte lenkens egen server. Ingenting sendes til Lunet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grondige controle volgt omleidingen en zoekt de leeftijd van het domein op via de server van de link zelf. Er wordt niets naar Lunet gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładne sprawdzanie śledzi przekierowania i ustala wiek domeny, łącząc się z serwerem samego linku. Nic nie jest wysyłane do Lunet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação profunda segue os redirecionamentos e consulta a idade do domínio entrando em contato com o próprio servidor do link. Nada é enviado ao Lunet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A verificação aprofundada segue os redirecionamentos e consulta a idade do domínio contactando o próprio servidor da ligação. Nada é enviado para a Lunet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificarea aprofundată urmărește redirecționările și află vechimea domeniului contactând serverul propriu al linkului. Nimic nu este trimis către Lunet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глубокая проверка отслеживает перенаправления и узнает возраст домена, обращаясь к серверу самой ссылки. В Lunet ничего не отправляется."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dôkladná kontrola sleduje presmerovania a zisťuje vek domény priamo od servera odkazu. Do Lunetu sa nič neodosiela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Djupkontrollen följer omdirigeringar och tar reda på domänens ålder genom att kontakta länkens egen server. Inget skickas till Lunet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตรวจสอบเชิงลึกจะติดตามการเปลี่ยนเส้นทางและค้นหาอายุของโดเมนโดยติดต่อเซิร์ฟเวอร์ของลิงก์นั้นโดยตรง ไม่มีข้อมูลใดถูกส่งไปยัง Lunet"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Derin denetim, yönlendirmeleri izler ve bağlantının kendi sunucusuyla iletişim kurarak alan adının yaşını öğrenir. Lunet’e hiçbir şey gönderilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Глибока перевірка відстежує переспрямування та дізнається вік домену, звертаючись до сервера самого посилання. До Lunet нічого не надсилається."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra sâu sẽ lần theo các chuyển hướng và tra cứu tuổi của tên miền bằng cách liên hệ chính máy chủ của liên kết. Không có gì được gửi đến Lunet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度检查会直接联系链接所在的服务器，跟踪重定向并查询域名的注册时长。不会向 Lunet 发送任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深度檢查會追蹤重新導向，並直接聯絡連結本身的伺服器來查詢網域註冊時間。不會傳送任何資料給 Lunet。"
          }
        }
      }
    },
