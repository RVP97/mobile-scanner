    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lunet uses the camera to read QR codes and barcodes. Nothing is recorded or uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet usa la cámara para leer códigos QR y de barras. No se graba ni se sube nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet utilise l’appareil photo pour lire les codes QR et les codes-barres. Rien n’est enregistré ni envoyé."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lunet uses Face ID to keep your scan history private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet usa Face ID para mantener privado tu historial de escaneos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet utilise Face ID pour protéger la confidentialité de votre historique de scans."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lunet can remember where you scanned each code. Locations stay on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet puede recordar dónde escaneaste cada código. Las ubicaciones se quedan en tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet peut mémoriser l’endroit où vous avez scanné chaque code. Les positions restent sur votre iPhone."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lunet saves the codes you create to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet guarda en tu fototeca los códigos que creas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet enregistre dans votre photothèque les codes que vous créez."
          }
