    "See where a code really goes, before anything opens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف إلى أين يؤدي الرمز فعلًا، قبل أن يُفتح أي شيء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira on porta realment un codi, abans que s’obri res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se, kam kód skutečně vede, dřív než se cokoli otevře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, hvor en kode faktisk fører hen, før noget åbnes."
          }
        },
