          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kestirme’ye kaydırın, sonra Bir Kestirme Seçin’e dokunun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перейдіть до розділу «Швидка команда» і торкніться «Вибрати швидку команду»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt đến Phím tắt, rồi chạm vào Chọn phím tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
