    "Map. Move it so the pin sits on the place to share." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خريطة. حرّكها حتى يقع الدبوس على المكان المراد مشاركته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Mou-lo perquè l’agulla quedi sobre el lloc que vols compartir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Posuňte ji tak, aby špendlík ukazoval na místo, které chcete sdílet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kort. Flyt det, så nålen står på det sted, du vil dele."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte. Verschiebe sie, bis die Stecknadel auf dem Ort liegt, den du teilen möchtest."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χάρτης. Μετακινήστε τον ώστε η πινέζα να βρίσκεται στο μέρος που θέλετε να κοινοποιήσετε."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Map. Move it so the pin sits on the place to share."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Muévelo para que el pin quede sobre el lugar que quieres compartir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartta. Siirrä sitä niin, että nasta on jaettavan paikan päällä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte. Déplacez-la pour placer l’épingle sur le lieu à partager."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפה. הזז אותה כך שהסיכה תהיה על המקום שברצונך לשתף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैप। इसे खिसकाएँ ताकि पिन उस जगह पर आ जाए जिसे आप शेयर करना चाहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karta. Pomaknite je tako da pribadača bude na mjestu koje dijelite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Térkép. Mozgassa úgy, hogy a gombostű a megosztani kívánt helyen legyen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peta. Geser agar pin berada di tempat yang ingin dibagikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa. Spostala finché il segnaposto è sul luogo da condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図。共有したい場所にピンが重なるように動かしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도. 핀이 공유할 장소에 오도록 지도를 이동하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peta. Gerakkannya supaya pin berada pada tempat yang hendak dikongsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kart. Flytt det slik at nålen står på stedet du vil dele."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaart. Verschuif hem zodat de speld op de plek staat die je wilt delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Przesuń ją, aby pinezka wskazywała miejsce do udostępnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Mova-o para que o alfinete fique sobre o lugar a compartilhar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa. Mova-o para que o pionés fique sobre o local a partilhar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartă. Mutați-o astfel încât pinul să fie pe locul de partajat."
