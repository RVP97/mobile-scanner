          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à créer, rien à quoi se connecter."
          }
        }
      }
    },
    "These shapes are too far from squares for cameras." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas formas se alejan demasiado de los cuadrados para las cámaras."
          }
        },
        "fr" : {
