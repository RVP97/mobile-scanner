        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua legível mesmo com %1$lld%% coberto ou riscado. Imprima-o com %2$@ ou mais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se scanează și cu %1$lld%% din el acoperit sau zgâriat. Imprimați-l la %2$@ sau mai mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считывается, даже если %1$lld%% кода закрыто или потерто. Печатайте размером от %2$@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskenuje sa, aj keď je %1$lld %% zakrytých alebo odretých. Vytlačte ho vo veľkosti %2$@ alebo väčšej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Går att skanna även när %1$lld%% är täckt eller repat. Skriv ut den i %2$@ eller större."
