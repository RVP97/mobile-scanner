        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลิงก์ Wi-Fi หรืออะไรก็ได้ โทรศัพท์ทุกเครื่องอ่านได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
