    "When you open a product barcode, Lunet asks Open Food Facts or Open Products Facts about that one number." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند فتح رمز شريطي لمنتج، يسأل Lunet Open Food Facts أو Open Products Facts عن هذا الرقم وحده."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan obres un codi de barres de producte, Lunet consulta només aquell número a Open Food Facts o Open Products Facts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když otevřete čárový kód produktu, Lunet se na to jedno číslo zeptá Open Food Facts nebo Open Products Facts."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du åbner en produktstregkode, spørger Lunet Open Food Facts eller Open Products Facts om netop det nummer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du einen Produkt-Barcode öffnest, fragt Lunet bei Open Food Facts oder Open Products Facts nur diese eine Nummer ab."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν ανοίγετε έναν γραμμωτό κωδικό προϊόντος, το Lunet ρωτά το Open Food Facts ή το Open Products Facts μόνο για αυτόν τον αριθμό."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you open a product barcode, Lunet asks Open Food Facts or Open Products Facts about that one number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando abres un código de barras de producto, Lunet consulta solo ese número en Open Food Facts u Open Products Facts."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun avaat tuotteen viivakoodin, Lunet kysyy Open Food Factsista tai Open Products Factsista vain sitä yhtä numeroa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous ouvrez un code-barres de produit, Lunet interroge Open Food Facts ou Open Products Facts sur ce seul numéro."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשאתה פותח ברקוד של מוצר, Lunet שואל את Open Food Facts או את Open Products Facts על המספר הזה בלבד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप कोई प्रोडक्ट बारकोड खोलते हैं, तो Lunet सिर्फ़ उसी एक नंबर के बारे में Open Food Facts या Open Products Facts से पूछता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad otvorite crtični kôd proizvoda, Lunet pita Open Food Facts ili Open Products Facts samo za taj jedan broj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termékvonalkód megnyitásakor a Lunet csak erre az egy számra kérdez rá az Open Food Facts vagy az Open Products Facts adatbázisában."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Anda membuka barcode produk, Lunet menanyakan satu nomor itu ke Open Food Facts atau Open Products Facts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando apri un codice a barre di un prodotto, Lunet chiede a Open Food Facts o Open Products Facts informazioni solo su quel numero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商品バーコードを開くと、LunetはOpen Food FactsまたはOpen Products Factsにその番号だけを問い合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제품 바코드를 열면 Lunet은 Open Food Facts 또는 Open Products Facts에 해당 번호 하나만 조회합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
