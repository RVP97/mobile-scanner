          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mot de passe sera de nouveau masqué à la fermeture."
          }
        }
      }
    },
    "The password in this code isn't valid for %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de este código no es válida para %@."
