    "It’s saved in History. Pull up from the camera anytime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظه في السجل. اسحب لأعلى من الكاميرا في أي وقت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’ha desat a l’historial. Llisca cap amunt des de la càmera quan vulguis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je uložen v Historii. Kdykoli ho vytáhněte z fotoaparátu nahoru."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er gemt i historikken. Træk op fra kameraet når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ist im Verlauf gesichert. Wische jederzeit von der Kamera aus nach oben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθηκεύτηκε στο Ιστορικό. Σύρετε προς τα πάνω από την κάμερα οποιαδήποτε στιγμή."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s saved in History. Pull up from the camera anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardó en el historial. Desliza hacia arriba desde la cámara cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se on tallennettu historiaan. Vedä ylös kameranäkymästä milloin tahansa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est enregistré dans l’historique. Balayez vers le haut depuis l’appareil photo à tout moment."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוא נשמר בהיסטוריה. אפשר למשוך למעלה מהמצלמה בכל עת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इतिहास में सहेजा गया है। कैमरा से कभी भी ऊपर स्वाइप करके इसे देखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremljeno je u Povijest. Povucite prema gore iz kamere kad god želite."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mentve az előzményekbe. A kameranézetből bármikor felhúzhatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersimpan di Riwayat. Tarik ke atas dari kamera kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È salvato nella cronologia. Scorri verso l’alto dalla fotocamera quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴に保存されました。カメラ画面からいつでも上にスワイプして表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에 저장되었습니다. 언제든지 카메라에서 위로 쓸어올리십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ia disimpan dalam Sejarah. Leret ke atas dari kamera bila-bila masa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er lagret i loggen. Dra opp fra kameraet når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij is bewaard in je geschiedenis. Veeg op elk moment omhoog vanuit de camera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowano w Historii. Przesuń w górę z aparatu w dowolnej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficou salvo no Histórico. Deslize para cima na câmera quando quiser."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficou guardado no Histórico. Passe o dedo para cima na câmara quando quiser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este salvat în Istoric. Glisați în sus din cameră oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код сохранен в истории. Смахните вверх на экране камеры в любой момент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložené v histórii. Z kamery ju kedykoľvek otvoríte potiahnutím nahor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den har sparats i historiken. Dra uppåt från kameran när du vill."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกไว้ในประวัติแล้ว ปัดขึ้นจากกล้องเพื่อดูได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş’e kaydedildi. İstediğiniz zaman kameradan yukarı kaydırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код збережено в історії. Проведіть угору на екрані камери будь-коли."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã đã được lưu trong Lịch sử. Vuốt lên từ camera bất cứ lúc nào."
