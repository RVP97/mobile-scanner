    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Lunet الكاميرا لقراءة رموز QR والرموز الشريطية. لا يتم تسجيل أو رفع أي شيء."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet fa servir la càmera per llegir codis QR i codis de barres. No es grava ni es puja res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet používá fotoaparát ke čtení QR kódů a čárových kódů. Nic se nenahrává ani neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet bruger kameraet til at læse QR-koder og stregkoder. Intet optages eller uploades."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet verwendet die Kamera, um QR-Codes und Barcodes zu lesen. Nichts wird aufgezeichnet oder hochgeladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lunet χρησιμοποιεί την κάμερα για να διαβάζει κωδικούς QR και γραμμωτούς κωδικούς. Τίποτα δεν καταγράφεται ή αποστέλλεται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lunet uses the camera to read QR codes and barcodes. Nothing is recorded or uploaded."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet uses the camera to read QR codes and barcodes. Nothing is recorded or uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet usa la cámara para leer códigos QR y de barras. No se graba ni se sube nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet käyttää kameraa QR- ja viivakoodien lukemiseen. Mitään ei tallenneta eikä lähetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet utilise l’appareil photo pour lire les codes QR et les codes-barres. Rien n’est enregistré ni envoyé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Lunet משתמש במצלמה כדי לקרוא קודי QR וברקודים. שום דבר לא מוקלט או מועלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet QR कोड और बारकोड पढ़ने के लिए कैमरा का उपयोग करता है। कुछ भी रिकॉर्ड या अपलोड नहीं किया जाता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet koristi kameru za očitavanje QR kodova i crtičnih kodova. Ništa se ne snima niti prenosi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lunet a kamerát QR-kódok és vonalkódok beolvasására használja. Semmit sem rögzít vagy tölt fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet menggunakan kamera untuk membaca kode QR dan barcode. Tidak ada yang direkam atau diunggah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet usa la fotocamera per leggere codici QR e codici a barre. Nulla viene registrato o caricato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LunetはQRコードやバーコードを読み取るためにカメラを使用します。記録やアップロードは一切されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet은 QR 코드와 바코드를 읽기 위해 카메라를 사용합니다. 아무것도 녹화하거나 업로드하지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet menggunakan kamera untuk membaca kod QR dan kod bar. Tiada apa-apa dirakam atau dimuat naik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet bruker kameraet til å lese QR-koder og strekkoder. Ingenting tas opp eller lastes opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet gebruikt de camera om QR-codes en barcodes te lezen. Er wordt niets vastgelegd of geüpload."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet używa aparatu do odczytywania kodów QR i kodów kreskowych. Nic nie jest nagrywane ani wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lunet usa a câmera para ler códigos QR e de barras. Nada é gravado nem enviado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lunet usa a câmara para ler códigos QR e de barras. Nada é gravado nem enviado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet folosește camera pentru a citi coduri QR și coduri de bare. Nimic nu este înregistrat sau încărcat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet использует камеру, чтобы читать QR-коды и штрихкоды. Ничего не записывается и не загружается."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet používa kameru na čítanie QR kódov a čiarových kódov. Nič sa nezaznamenáva ani neodosiela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet använder kameran för att läsa QR-koder och streckkoder. Inget spelas in eller laddas upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet ใช้กล้องเพื่ออ่าน QR โค้ดและบาร์โค้ด ไม่มีการบันทึกหรืออัปโหลดใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet, QR kodları ve barkodları okumak için kamerayı kullanır. Hiçbir şey kaydedilmez veya yüklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet використовує камеру, щоб зчитувати QR-коди та штрихкоди. Нічого не записується і не вивантажується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet dùng camera để đọc mã QR và mã vạch. Không có gì được ghi lại hay tải lên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet 使用相机读取 QR 码和条形码。不会录制或上传任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet 使用相機來讀取 QR 碼和條碼。不會錄製或上傳任何內容。"
          }
        }
      }
    },
