          "stringUnit" : {
            "state" : "translated",
            "value" : "“.%@” addresses are often used for scams."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las direcciones “.%@” se usan a menudo para estafas."
