    "Adding to Wallet needs a real iPhone or iPad — App Attest isn't available on this device or in the Simulator." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتطلب الإضافة إلى المحفظة جهاز iPhone أو iPad حقيقيًا — خدمة App Attest غير متاحة على هذا الجهاز أو في المحاكي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per afegir a Wallet cal un iPhone o iPad real: App Attest no està disponible en aquest dispositiu ni al simulador."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidání do Walletu vyžaduje skutečný iPhone nebo iPad — App Attest není na tomto zařízení ani v Simulátoru k dispozici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal bruge en rigtig iPhone eller iPad for at føje til Wallet — App Attest er ikke tilgængelig på denne enhed eller i simulatoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Hinzufügen zu Wallet ist ein echtes iPhone oder iPad nötig — App Attest ist auf diesem Gerät oder im Simulator nicht verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η προσθήκη στο Wallet απαιτεί πραγματικό iPhone ή iPad — το App Attest δεν είναι διαθέσιμο σε αυτήν τη συσκευή ή στον Προσομοιωτή."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adding to Wallet needs a real iPhone or iPad — App Attest isn't available on this device or in the Simulator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para agregar a Wallet necesitas un iPhone o iPad real: App Attest no está disponible en este dispositivo ni en el simulador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
