        }
      }
    },
    "Swipe right on a scan to pin it. Pinned codes also wait for you on Home." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب إلى اليسار على عملية مسح لتثبيتها. تنتظرك الرموز المثبّتة أيضًا في الصفحة الرئيسية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca cap a la dreta sobre un escaneig per fixar-lo. Els codis fixats també t’esperen a Inici."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přejetím doprava skenování připnete. Připnuté kódy na vás čekají i na hlavní stránce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub til højre på en scanning for at fastgøre den. Fastgjorte koder venter også på dig i Hjem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche auf einem Scan nach rechts, um ihn anzuheften. Angeheftete Codes warten auch auf der Startseite auf dich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε προς τα δεξιά σε μια σάρωση για να την καρφιτσώσετε. Οι καρφιτσωμένοι κωδικοί σάς περιμένουν επίσης στην Αρχική."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe right on a scan to pin it. Pinned codes also wait for you on Home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la derecha sobre un escaneo para fijarlo. Los códigos fijados también te esperan en Inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinnitä skannaus pyyhkäisemällä sitä oikealle. Kiinnitetyt koodit odottavat sinua myös Koti-näkymässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez un scan vers la droite pour l’épingler. Les codes épinglés vous attendent aussi sur l’accueil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק שמאלה על סריקה כדי להצמיד אותה. קודים מוצמדים מחכים לך גם ב״בית״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी स्कैन को पिन करने के लिए उस पर दाईं ओर स्वाइप करें। पिन किए गए कोड होम पर भी आपका इंतज़ार करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite udesno po skeniranju da biste ga prikvačili. Prikvačeni kodovi čekaju vas i na Početnoj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza jobbra a beolvasást a kitűzéshez. A kitűzött kódok a Kezdőlapon is várják."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesek ke kanan pada pindaian untuk menyematkannya. Kode yang disematkan juga menunggu Anda di Beranda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a destra su una scansione per fissarla. I codici fissati ti aspettano anche nella Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンを右にスワイプするとピンで固定できます。固定したコードはホームにも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔을 오른쪽으로 쓸어넘겨 고정하십시오. 고정된 코드는 홈에서도 바로 볼 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret ke kanan pada imbasan untuk mengepinnya. Kod yang dipin juga menanti anda di Utama."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til høyre på en skanning for å feste den. Festede koder venter også på deg på Hjem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar rechts over een scan om hem vast te zetten. Vastgezette codes staan ook voor je klaar op het startscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń skan w prawo, aby go przypiąć. Przypięte kody czekają też na stronie głównej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para a direita em um escaneamento para fixá-lo. Os códigos fixados também esperam por você no Início."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o dedo para a direita numa leitura para a fixar. Os códigos fixados também ficam à sua espera no Início."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisați la dreapta pe o scanare pentru a o fixa. Codurile fixate vă așteaptă și în Acasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вправо по сканированию, чтобы закрепить его. Закрепленные коды также ждут вас в разделе «Главная»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím skenu doprava ho pripnete. Pripnuté kódy na vás čakajú aj na karte Domov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep åt höger på en skanning för att fästa den. Fästa koder väntar också på dig i Hem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดไปทางขวาบนการสแกนเพื่อปักหมุด โค้ดที่ปักหมุดจะรอคุณอยู่ที่หน้าหลักด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabitlemek için bir taramanın üzerinde sağa kaydırın. Sabitlenen kodlar sizi Ana Sayfa’da da bekler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть праворуч по скануванню, щоб закріпити його. Закріплені коди також чекають на вас у розділі «Головна»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt sang phải trên một lượt quét để ghim. Mã được ghim cũng chờ bạn ở Trang chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在扫描记录上向右轻扫即可置顶。置顶的码也会显示在主页上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在掃描項目上向右滑動即可釘選。釘選的條碼也會在「首頁」等著你。"
          }
        }
      }
    },
