    "There's nothing to sign up for and nothing to sign in to." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد ما تشترك فيه ولا ما تسجّل الدخول إليه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No t’has de registrar ni iniciar sessió enlloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikde se nemusíte registrovat ani přihlašovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er intet at tilmelde sig og intet at logge ind på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt nichts zu registrieren und nichts, wo du dich anmelden musst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχει τίποτα για εγγραφή και τίποτα για σύνδεση."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There's nothing to sign up for and nothing to sign in to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada en qué registrarse ni nada en qué iniciar sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei rekisteröitymistä eikä kirjautumista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à créer, rien à quoi se connecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין צורך להירשם לשום דבר ואין צורך להתחבר לשום דבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "न कहीं साइन अप करना है, न साइन इन।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nema se za što registrirati niti se ima gdje prijaviti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs mire regisztrálni, és nincs hová bejelentkezni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang perlu didaftarkan dan tidak ada yang perlu masuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’è nulla a cui iscriversi né a cui accedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録もサインインも必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
