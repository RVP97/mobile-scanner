          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF kodar siffror i par, så antalet måste vara jämnt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF เข้ารหัสตัวเลขเป็นคู่ จึงต้องมีจำนวนหลักเป็นเลขคู่"
