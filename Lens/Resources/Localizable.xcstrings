    "QR codes work with every phone camera. Pick another format only if something asks for it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل رموز QR مع كاميرا أي هاتف. لا تختر تنسيقًا آخر إلا إذا طُلب منك ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els codis QR funcionen amb la càmera de qualsevol telèfon. Tria un altre format només si algú te’l demana."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kódy fungují s fotoaparátem každého telefonu. Jiný formát zvolte, jen pokud ho něco vyžaduje."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-koder virker med alle telefonkameraer. Vælg kun et andet format, hvis noget kræver det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-Codes funktionieren mit jeder Handykamera. Wähle ein anderes Format nur, wenn es verlangt wird."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κωδικοί QR λειτουργούν με την κάμερα κάθε τηλεφώνου. Επιλέξτε άλλη μορφή μόνο αν σας ζητηθεί."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR codes work with every phone camera. Pick another format only if something asks for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códigos QR funcionan con la cámara de cualquier teléfono. Elige otro formato solo si algo te lo pide."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-koodit toimivat kaikkien puhelinten kameroilla. Valitse muu muoto vain, jos sitä erikseen vaaditaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les codes QR fonctionnent avec l’appareil photo de tous les téléphones. Ne choisissez un autre format que si on vous le demande."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קודי QR עובדים עם כל מצלמת טלפון. בחר פורמט אחר רק אם משהו דורש זאת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR कोड हर फ़ोन के कैमरा के साथ काम करते हैं। कोई दूसरा फ़ॉर्मैट तभी चुनें जब उसकी माँग की जाए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kodovi rade sa svakom kamerom telefona. Drugi format odaberite samo ako se to od vas traži."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A QR-kódok minden telefon kamerájával működnek. Más formátumot csak akkor válasszon, ha valami azt kéri."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kode QR dapat dibaca semua kamera ponsel. Pilih format lain hanya jika diminta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici QR funzionano con la fotocamera di qualsiasi telefono. Scegli un altro formato solo se richiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QRコードはどのスマートフォンのカメラでも読み取れます。ほかのフォーマットは、指定がある場合のみ選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 코드는 모든 휴대폰 카메라에서 작동합니다. 다른 포맷이 필요한 경우에만 다른 포맷을 선택하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod QR berfungsi dengan setiap kamera telefon. Pilih format lain hanya jika sesuatu memintanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-koder fungerer med alle telefonkameraer. Velg et annet format bare hvis noe krever det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-codes werken met elke telefooncamera. Kies alleen een ander formaat als erom wordt gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kody QR działają z aparatem każdego telefonu. Wybierz inny format tylko wtedy, gdy coś tego wymaga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Códigos QR funcionam com a câmera de qualquer celular. Escolha outro formato só se algo exigir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os códigos QR funcionam com a câmara de qualquer telemóvel. Escolha outro formato só se algo o exigir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codurile QR funcționează cu camera oricărui telefon. Alegeți alt format doar dacă vi se cere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-коды читает камера любого телефона. Выбирайте другой формат, только если его требуют."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kódy fungujú s kamerou každého telefónu. Iný formát vyberte, iba ak ho niečo vyžaduje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-koder fungerar med alla telefonkameror. Välj bara ett annat format om något kräver det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR โค้ดใช้ได้กับกล้องโทรศัพท์ทุกเครื่อง เลือกรูปแบบอื่นเฉพาะเมื่อมีสิ่งใดกำหนดให้ใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR kodlar her telefon kamerasıyla çalışır. Yalnızca bir şey gerektiriyorsa başka bir biçim seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR-коди зчитує камера будь-якого телефона. Вибирайте інший формат, лише якщо його вимагають."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã QR hoạt động với mọi camera điện thoại. Chỉ chọn định dạng khác khi có yêu cầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 码适用于所有手机相机。仅在有特定要求时才选择其他格式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 碼適用於每支手機的相機。只有在有特別要求時才選擇其他格式。"
          }
        }
      }
    },
