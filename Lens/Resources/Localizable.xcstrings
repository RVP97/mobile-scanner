        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק למטה, הקש על ״סריקה״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे की ओर स्वाइप करें, “स्कैन करें” पर टैप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite prema dolje, dodirnite Skeniraj."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzzon lefelé, és koppintson a Beolvasás elemre."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesek ke bawah, ketuk Pindai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso il basso e tocca Scansiona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下にスワイプして、「スキャン」をタップ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래로 쓸어내린 다음 스캔을 탭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret ke bawah, ketik Imbas."
