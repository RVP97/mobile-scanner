        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта. Переместите ее так, чтобы булавка оказалась на месте, которым хотите поделиться."
          }
        },
        "sk" : {
          "stringUnit" : {
