          "stringUnit" : {
            "state" : "translated",
            "value" : "“स्कैन करें” पर टैप करें और कैमरा को किसी भी कोड की ओर करें। यह अगली बार के लिए यहाँ रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodirnite Skeniraj i usmjerite prema bilo kojem kôdu. Bit će ovdje i idući put."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson a Beolvasás gombra, és irányítsa a kamerát bármelyik kódra. Legközelebb itt találja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Pindai dan arahkan ke kode apa pun. Kode akan ada di sini untuk lain kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Scansiona e inquadra un codice qualsiasi. Lo ritroverai qui la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「スキャン」をタップして、コードにカメラを向けてください。次回からはここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔을 탭하고 아무 코드나 비추십시오. 다음번에도 여기에서 볼 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketik Imbas dan halakan ke mana-mana kod. Ia akan berada di sini untuk kali seterusnya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på Skann, og rett kameraet mot en kode. Den blir liggende her til neste gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op ‘Scan’ en richt op een code. De volgende keer staat hij hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij w Skanuj i skieruj na dowolny kod. Będzie tu czekać następnym razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Escanear e aponte para qualquer código. Ele ficará aqui para a próxima vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Ler e aponte para qualquer código. Fica aqui guardado para a próxima vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apăsați pe Scanați și îndreptați camera spre orice cod. Îl veți găsi aici data viitoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь «Сканировать» и наведите камеру на любой код. В следующий раз он будет здесь."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ťuknite na Skenovať a namierte na akýkoľvek kód. Nabudúce ho nájdete tu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Skanna och rikta mot valfri kod. Den finns här nästa gång."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะ “สแกน” แล้วหันกล้องไปที่โค้ดใดก็ได้ โค้ดจะอยู่ที่นี่สำหรับครั้งถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tara’ya dokunun ve herhangi bir koda doğrultun. Bir dahaki sefere burada olacak."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
