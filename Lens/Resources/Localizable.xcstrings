    "6 digits (number system 0), 7 with a number system of 0 or 1, 8 with the check digit, or a 12-digit UPC-A to shorten." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 أرقام (نظام الترقيم 0)، أو 7 مع نظام ترقيم 0 أو 1، أو 8 مع رقم التحقق، أو رمز UPC-A من 12 رقمًا لاختصاره."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 dígits (sistema numèric 0), 7 amb sistema numèric 0 o 1, 8 amb el dígit de control, o un UPC-A de 12 dígits per escurçar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 číslic (číselná soustava 0), 7 s číselnou soustavou 0 nebo 1, 8 s kontrolní číslicí, nebo 12místný UPC-A ke zkrácení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 cifre (talsystem 0), 7 med talsystem 0 eller 1, 8 med kontrolcifferet eller en 12-cifret UPC-A, der skal forkortes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 Ziffern (Nummernsystem 0), 7 mit Nummernsystem 0 oder 1, 8 mit Prüfziffer oder ein 12-stelliger UPC-A zum Kürzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 ψηφία (σύστημα αριθμών 0), 7 με σύστημα αριθμών 0 ή 1, 8 με το ψηφίο ελέγχου ή ένας 12ψήφιος UPC-A για συντόμευση."
          }
        },
        "en-GB" : {
          "stringUnit" : {
