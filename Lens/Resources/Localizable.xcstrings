    "This device limits camera use. You can still scan a code in a photo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيّد هذا الجهاز استخدام الكاميرا. لا يزال بإمكانك مسح رمز في صورة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest dispositiu limita l’ús de la càmera. Encara pots escanejar un codi d’una foto."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto zařízení omezuje používání fotoaparátu. Kód můžete dál naskenovat z fotky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne enhed begrænser brugen af kameraet. Du kan stadig scanne en kode i et foto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät schränkt die Kameranutzung ein. Du kannst aber einen Code in einem Foto scannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η συσκευή περιορίζει τη χρήση της κάμερας. Μπορείτε ακόμα να σαρώσετε έναν κωδικό σε μια φωτογραφία."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device limits camera use. You can still scan a code in a photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo limita el uso de la cámara. Aún puedes escanear un código en una foto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä laite rajoittaa kameran käyttöä. Voit silti skannata koodin kuvasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil limite l’utilisation de l’appareil photo. Vous pouvez toujours scanner un code dans une photo."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המכשיר הזה מגביל את השימוש במצלמה. עדיין אפשר לסרוק קוד בתמונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह डिवाइस कैमरा के उपयोग को सीमित करता है। आप फिर भी किसी तस्वीर में मौजूद कोड स्कैन कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj uređaj ograničava upotrebu kamere. I dalje možete skenirati kôd na fotografiji."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az eszköz korlátozza a kamera használatát. Fotón lévő kódot továbbra is beolvashat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini membatasi penggunaan kamera. Anda tetap dapat memindai kode di foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo limita l’uso della fotocamera. Puoi comunque scansionare un codice in una foto."
          }
        },
        "ja" : {
