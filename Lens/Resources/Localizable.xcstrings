        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο αριθμός UPC-A έχει πολύ λίγα μηδενικά για να συντομευτεί σε UPC-E. Χρησιμοποιήστε UPC-A."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This UPC-A number has too few zeros to shorten into UPC-E. Use UPC-A instead."
