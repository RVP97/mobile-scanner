    "WEP keys are 5 or 13 characters, or 10 or 26 hex digits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفاتيح WEP تتكون من 5 أو 13 حرفًا، أو 10 أو 26 رقمًا سداسيًا عشريًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les claus WEP tenen 5 o 13 caràcters, o 10 o 26 dígits hexadecimals."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klíče WEP mají 5 nebo 13 znaků, nebo 10 či 26 šestnáctkových číslic."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEP-nøgler er på 5 eller 13 tegn eller 10 eller 26 hexadecimale cifre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEP-Schlüssel haben 5 oder 13 Zeichen oder 10 oder 26 Hexadezimalziffern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα κλειδιά WEP έχουν 5 ή 13 χαρακτήρες ή 10 ή 26 δεκαεξαδικά ψηφία."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEP keys are 5 or 13 characters, or 10 or 26 hex digits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves WEP tienen 5 o 13 caracteres, o 10 o 26 dígitos hexadecimales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEP-avaimissa on 5 tai 13 merkkiä tai 10 tai 26 heksadesimaalinumeroa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés WEP comptent 5 ou 13 caractères, ou 10 ou 26 chiffres hexadécimaux."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מפתחות WEP הם באורך 5 או 13 תווים, או 10 או 26 ספרות הקסדצימליות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEP कुंजियाँ 5 या 13 कैरेक्टर की, या 10 या 26 हेक्स अंकों की होती हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEP ključevi imaju 5 ili 13 znakova, ili 10 ili 26 heksadecimalnih znamenki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A WEP-kulcsok 5 vagy 13 karakteresek, illetve 10 vagy 26 hexadecimális számjegyből állnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci WEP terdiri dari 5 atau 13 karakter, atau 10 atau 26 digit heksadesimal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi WEP hanno 5 o 13 caratteri, oppure 10 o 26 cifre esadecimali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEPキーは5文字または13文字、または16進数で10桁または26桁です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WEP 키는 5자 또는 13자, 또는 16진수 10자리 또는 26자리입니다."
          }
        },
        "ms" : {
