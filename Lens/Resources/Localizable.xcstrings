    "Use the GTIN assigned to your product. Leave off the last digit and Lunet adds the check digit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم رقم GTIN المخصص لمنتجك. اترك الرقم الأخير وسيضيف Lunet رقم التحقق."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fes servir el GTIN assignat al teu producte. Omet l’últim dígit i Lunet hi afegirà el dígit de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte GTIN přidělený vašemu produktu. Poslední číslici vynechte a Lunet přidá kontrolní číslici."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brug det GTIN, der er tildelt dit produkt. Udelad det sidste ciffer, så tilføjer Lunet kontrolcifferet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die GTIN, die deinem Produkt zugewiesen ist. Lass die letzte Ziffer weg, dann fügt Lunet die Prüfziffer hinzu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε τον GTIN που έχει αντιστοιχιστεί στο προϊόν σας. Παραλείψτε το τελευταίο ψηφίο και το Lunet προσθέτει το ψηφίο ελέγχου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the GTIN assigned to your product. Leave off the last digit and Lunet adds the check digit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el GTIN asignado a tu producto. Omite el último dígito y Lunet agrega el dígito verificador."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä tuotteellesi määritettyä GTIN-numeroa. Jätä viimeinen numero pois, niin Lunet lisää tarkistusnumeron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le GTIN attribué à votre produit. Omettez le dernier chiffre et Lunet ajoutera la clé de contrôle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתמש ב־GTIN שהוקצה למוצר שלך. השמט את הספרה האחרונה ו־Lunet יוסיף את ספרת הביקורת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने प्रोडक्ट को दिया गया GTIN उपयोग करें। आखिरी अंक छोड़ दें, Lunet चेक डिजिट जोड़ देगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite GTIN dodijeljen vašem proizvodu. Izostavite zadnju znamenku i Lunet će dodati kontrolnu znamenku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Használja a termékéhez rendelt GTIN-t. Hagyja el az utolsó számjegyet, és a Lunet hozzáadja az ellenőrző számjegyet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan GTIN yang ditetapkan untuk produk Anda. Hilangkan digit terakhir dan Lunet akan menambahkan digit periksa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il GTIN assegnato al tuo prodotto. Ometti l’ultima cifra e Lunet aggiunge la cifra di controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "商品に割り当てられたGTINを使用してください。最後の桁を省くと、Lunetがチェックデジットを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제품에 할당된 GTIN을 사용하십시오. 마지막 숫자를 빼고 입력하면 Lunet이 검증 숫자를 추가합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan GTIN yang diberikan kepada produk anda. Tinggalkan digit terakhir dan Lunet akan menambah digit semak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk GTIN-nummeret som er tildelt produktet ditt. Utelat det siste sifferet, så legger Lunet til kontrollsifferet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de GTIN die aan je product is toegekend. Laat het laatste cijfer weg, dan voegt Lunet het controlecijfer toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj numeru GTIN przypisanego do produktu. Pomiń ostatnią cyfrę, a Lunet doda cyfrę kontrolną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o GTIN atribuído ao seu produto. Omita o último dígito e o Lunet adiciona o dígito verificador."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o GTIN atribuído ao seu produto. Omita o último dígito e a Lunet adiciona o dígito de controlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosiți GTIN-ul atribuit produsului dvs. Omiteți ultima cifră, iar Lunet adaugă cifra de control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте GTIN, присвоенный вашему товару. Не вводите последнюю цифру — Lunet добавит контрольную цифру."
