    "Opening a link, joining a network or adding a contact happens in the app you choose, under its own privacy policy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم فتح الرابط أو الانضمام إلى الشبكة أو إضافة جهة الاتصال في التطبيق الذي تختاره، وفقًا لسياسة الخصوصية الخاصة به."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrir un enllaç, connectar-te a una xarxa o afegir un contacte passa a l’app que triïs, sota la seva pròpia política de privadesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevření odkazu, připojení k síti nebo přidání kontaktu proběhne ve vámi zvolené aplikaci a řídí se jejími zásadami ochrany soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du åbner et link, tilslutter et netværk eller tilføjer en kontakt, sker det i den app, du vælger, under dens egen privatlivspolitik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Link öffnen, einem Netzwerk beitreten oder einen Kontakt hinzufügen geschieht in der App deiner Wahl, gemäß deren eigener Datenschutzrichtlinie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το άνοιγμα ενός συνδέσμου, η σύνδεση σε δίκτυο ή η προσθήκη επαφής γίνεται στην εφαρμογή που επιλέγετε, σύμφωνα με τη δική της πολιτική απορρήτου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opening a link, joining a network or adding a contact happens in the app you choose, under its own privacy policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir un enlace, conectarte a una red o agregar un contacto ocurre en la app que elijas, bajo su propia política de privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkin avaaminen, verkkoon liittyminen tai yhteystiedon lisääminen tapahtuu valitsemassasi apissa sen oman tietosuojakäytännön mukaisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir un lien, rejoindre un réseau ou ajouter un contact se fait dans l’app choisie, selon sa propre politique de confidentialité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתיחת קישור, התחברות לרשת או הוספת איש קשר מתבצעות ביישום שתבחר, בכפוף למדיניות הפרטיות שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक खोलना, नेटवर्क से जुड़ना या संपर्क जोड़ना आपके चुने हुए ऐप में होता है, और उस पर उसी ऐप की गोपनीयता नीति लागू होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvaranje poveznice, pridruživanje mreži ili dodavanje kontakta odvija se u aplikaciji koju odaberete, prema njezinim pravilima o privatnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A linkek megnyitása, a hálózati csatlakozás és a kontaktok hozzáadása a választott appban történik, annak saját adatvédelmi szabályzata szerint."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka tautan, bergabung ke jaringan, atau menambahkan kontak terjadi di app yang Anda pilih, sesuai kebijakan privasinya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprire un link, connettersi a una rete o aggiungere un contatto avviene nell’app che scegli, secondo la sua informativa sulla privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクを開く、ネットワークに接続する、連絡先を追加するなどの操作は、選択したアプリ内で、そのアプリのプライバシーポリシーに従って行われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크 열기, 네트워크 연결, 연락처 추가는 선택한 앱에서 이루어지며 해당 앱의 개인정보 처리방침이 적용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka pautan, menyertai rangkaian atau menambah kenalan berlaku dalam apl yang anda pilih, di bawah dasar privasinya sendiri."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du åpner en lenke, kobler til et nettverk eller legger til en kontakt, skjer det i appen du velger, under dens egne personvernregler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een link openen, verbinding maken met een netwerk of een contact toevoegen gebeurt in de app die je kiest, onder het eigen privacybeleid van die app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwieranie linku, łączenie z siecią czy dodawanie kontaktu odbywa się w wybranej aplikacji, zgodnie z jej własną polityką prywatności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir um link, conectar-se a uma rede ou adicionar um contato acontece no app que você escolher, sob a política de privacidade dele."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir uma ligação, ligar-se a uma rede ou adicionar um contacto acontece na app que escolher, ao abrigo da respetiva política de privacidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschiderea unui link, conectarea la o rețea sau adăugarea unui contact au loc în aplicația aleasă, conform propriei politici de confidențialitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открытие ссылки, подключение к сети или добавление контакта происходит в выбранном вами приложении в соответствии с его собственной политикой конфиденциальности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorenie odkazu, pripojenie k sieti či pridanie kontaktu prebieha v aplikácii, ktorú si vyberiete, podľa jej vlastných zásad ochrany súkromia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att öppna en länk, ansluta till ett nätverk eller lägga till en kontakt sker i appen du väljer, enligt dess egen integritetspolicy."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปิดลิงก์ การเข้าร่วมเครือข่าย หรือการเพิ่มรายชื่อผู้ติดต่อจะเกิดขึ้นในแอปที่คุณเลือก ภายใต้นโยบายความเป็นส่วนตัวของแอปนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bağlantıyı açmak, bir ağa katılmak veya kişi eklemek, seçtiğiniz uygulamada ve o uygulamanın kendi gizlilik politikası altında gerçekleşir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкриття посилання, під’єднання до мережі чи додавання контакту відбувається у вибраній вами програмі відповідно до її власної політики конфіденційності."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc mở liên kết, kết nối mạng hay thêm liên hệ diễn ra trong ứng dụng bạn chọn, theo chính sách quyền riêng tư của ứng dụng đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开链接、加入网络或添加联系人等操作均在你选择的 App 中进行，并受该 App 自身隐私政策的约束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟連結、加入網路或加入聯絡人，都是在你選擇的 App 中進行，並適用該 App 自己的隱私權政策。"
          }
        }
      }
    },
