          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोगो अपने चारों ओर खाली जगह छोड़ता है और एरर करेक्शन को हाई पर कर देता है, ताकि कोड फिर भी पढ़ा जा सके।"
