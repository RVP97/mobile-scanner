    "Tap +, search for Lunet, and choose Scan Code." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على +، وابحث عن Lunet، واختر «مسح رمز»."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca +, cerca Lunet i tria Escaneja un codi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klepněte na +, vyhledejte Lunet a zvolte Naskenovat kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på +, søg efter Lunet, og vælg Scan kode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf +, suche nach Lunet und wähle „Code scannen“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αγγίξτε το +, αναζητήστε το Lunet και επιλέξτε «Σάρωση κωδικού»."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap +, search for Lunet, and choose Scan Code."
          }
        },
        "es" : {
          "stringUnit" : {
