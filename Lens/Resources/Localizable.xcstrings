    "ITF encodes digits in pairs, so it needs an even count." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرمّز ITF الأرقام في أزواج، لذا يحتاج إلى عدد زوجي منها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF codifica els dígits per parelles, així que en necessita un nombre parell."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF kóduje číslice po dvojicích, takže potřebuje sudý počet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF koder cifre i par, så antallet skal være lige."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF codiert Ziffern paarweise und braucht daher eine gerade Anzahl."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο ITF κωδικοποιεί ψηφία σε ζεύγη, οπότε χρειάζεται ζυγό πλήθος."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF encodes digits in pairs, so it needs an even count."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF codifica los dígitos en pares, así que necesita una cantidad par."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF koodaa numerot pareittain, joten niitä on oltava parillinen määrä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF encode les chiffres par paires : il en faut un nombre pair."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏ITF מקודד ספרות בזוגות, ולכן נדרש מספר זוגי של ספרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF अंकों को जोड़ों में एन्कोड करता है, इसलिए इसमें अंकों की संख्या सम होनी चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF kodira znamenke u parovima pa treba paran broj znamenki."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ITF párokban kódolja a számjegyeket, ezért páros számú kell."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF mengodekan digit berpasangan, jadi jumlahnya harus genap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF codifica le cifre a coppie, quindi ne richiede un numero pari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITFは数字を2つずつ組にしてエンコードするため、偶数個の数字が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF는 숫자를 두 개씩 인코딩하므로 숫자 개수가 짝수여야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF mengekod digit secara berpasangan, jadi ia memerlukan bilangan genap."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF koder sifre i par, så antallet må være et partall."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF codeert cijfers in paren en heeft dus een even aantal nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ITF koduje cyfry parami, więc wymaga parzystej liczby cyfr."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
