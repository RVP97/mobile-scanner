            "state" : "translated",
            "value" : "Scorri fino a Comando rapido, poi tocca Scegli un comando rapido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ショートカット」までスワイプして、「ショートカットを選択」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어로 쓸어넘긴 다음 단축어 선택을 탭하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret ke Pintasan, kemudian ketik Pilih Pintasan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip til Snarvei, og trykk deretter på Velg en snarvei."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar ‘Opdracht’ en tik dan op ‘Kies een opdracht’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń do Skrótu, a następnie stuknij w Wybierz skrót."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize até Atalho e toque em Escolher um Atalho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o dedo até Atalho e toque em Escolher um atalho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisați la Scurtătură, apoi apăsați pe Alegeți o scurtătură."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните к разделу «Быстрая команда» и коснитесь «Выбрать быструю команду»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnite na Skratka a ťuknite na Vybrať skratku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep till Genväg och tryck sedan på Välj en genväg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
