      }
    },
    "Lunet can only add images to your library. Turn on access in Settings to save codes there." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet solo puede agregar imágenes a tu fototeca. Activa el acceso en Configuración para guardar códigos ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet peut seulement ajouter des images à votre photothèque. Activez l’accès dans Réglages pour y enregistrer des codes."
          }
        }
      }
    },
    "Lunet can read %@ but can't make it yet." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet puede leer %@, pero aún no puede crearlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet sait lire le format %@, mais pas encore le créer."
          }
        }
      }
    },
    "Lunet can't verify who receives this. Check the address with the person you're paying." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet no puede verificar quién recibe esto. Confirma la dirección con la persona a la que le pagas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet ne peut pas vérifier qui reçoit ce paiement. Confirmez l’adresse avec la personne que vous payez."
          }
        }
      }
    },
    "Lunet can’t use a camera right now. You can still scan a code in a photo." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet no puede usar una cámara en este momento. Aún puedes escanear un código en una foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet ne peut pas utiliser d’appareil photo pour le moment. Vous pouvez toujours scanner un code dans une photo."
          }
        }
      }
    },
    "Lunet checks every link first" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet revisa cada enlace primero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet vérifie chaque lien d’abord"
          }
        }
      }
    },
    "Lunet doesn't collect usage data, and there are no ads." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet no recopila datos de uso y no tiene anuncios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet ne collecte aucune donnée d’utilisation et n’affiche aucune publicité."
          }
        }
      }
    },
    "Lunet follows your iPhone's language. You can choose a different one for Lunet in the Settings app." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lunet follows your iPad's language. You can choose a different one for Lunet in the Settings app."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lunet follows your iPhone's language. You can choose a different one for Lunet in the Settings app."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lunet usa el idioma de tu iPad. Puedes elegir otro para Lunet en la app Configuración."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lunet usa el idioma de tu iPhone. Puedes elegir otro para Lunet en la app Configuración."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lunet suit la langue de votre iPad. Vous pouvez en choisir une autre pour Lunet dans l’app Réglages."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Lunet suit la langue de votre iPhone. Vous pouvez en choisir une autre pour Lunet dans l’app Réglages."
                }
              }
            }
          }
        }
      }
    },
    "Lunet found something unusual about this link. Only continue if you trust whoever gave you the code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet encontró algo inusual en este enlace. Continúa solo si confías en quien te dio el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet a remarqué quelque chose d’inhabituel dans ce lien. Ne continuez que si vous faites confiance à la personne qui vous a donné le code."
          }
        }
      }
    },
    "Lunet has no account and no tracking. We never see what you scan, create or where you are." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet no tiene cuentas ni rastreo. Nunca vemos lo que escaneas, lo que creas ni dónde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet n’a ni compte ni suivi. Nous ne voyons jamais ce que vous scannez, ce que vous créez, ni où vous êtes."
          }
        }
      }
    },
    "Lunet knew what it was and what to do next." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet supo qué era y qué hacer después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet a su ce que c’était et quoi faire ensuite."
          }
        }
      }
    },
    "Lunet knows what it’s looking at, so the next step is always one tap." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet sabe lo que está viendo, así que el siguiente paso siempre está a un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet sait ce qu’elle regarde : l’étape suivante est toujours à portée d’un toucher."
          }
        }
      }
    },
    "Lunet needs your camera to read codes" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet necesita tu cámara para leer códigos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet a besoin de l’appareil photo pour lire les codes"
          }
        }
      }
    },
    "Lunet reads any code and checks links before you open them." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet lee cualquier código y revisa los enlaces antes de que los abras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet lit tous les codes et vérifie les liens avant que vous les ouvriez."
          }
        }
      }
    },
    "Lunet reads any code, shows you where it really leads, and hands you the one thing to do next." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet lee cualquier código, te muestra adónde lleva en realidad y te da justo lo que necesitas hacer después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet lit tous les codes, vous montre où ils mènent vraiment et vous propose la seule chose à faire ensuite."
          }
        }
      }
    },
    "Lunet stopped it before anything opened." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet lo detuvo antes de que se abriera nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet l’a arrêté avant que quoi que ce soit ne s’ouvre."
          }
        }
      }
    },
    "Lunet thinks this link is a scam. Only continue if you trust whoever gave you the code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet cree que este enlace es una estafa. Continúa solo si confías en quien te dio el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet pense que ce lien est une arnaque. Ne continuez que si vous faites confiance à la personne qui vous a donné le code."
          }
        }
      }
    },
