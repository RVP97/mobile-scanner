    "Swipe down from the top-right corner to open Control Center." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لأسفل من الزاوية العلوية اليسرى لفتح مركز التحكم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llisca cap avall des de l’angle superior dret per obrir el Centre de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovládací centrum otevřete přejetím dolů z pravého horního rohu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skub nedad fra øverste højre hjørne for at åbne Kontrolcenter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche von der oberen rechten Ecke nach unten, um das Kontrollzentrum zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε προς τα κάτω από την πάνω δεξιά γωνία για να ανοίξετε το Κέντρο ελέγχου."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe down from the top-right corner to open Control Centre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza hacia abajo desde la esquina superior derecha para abrir el Centro de control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Ohjauskeskus pyyhkäisemällä alas oikeasta yläkulmasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez vers le bas depuis le coin supérieur droit pour ouvrir le centre de contrôle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החלק כלפי מטה מהפינה השמאלית העליונה כדי לפתוח את מרכז הבקרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कंट्रोल सेंटर खोलने के लिए ऊपर दाएँ कोने से नीचे की ओर स्वाइप करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite prema dolje iz gornjeg desnog kuta kako biste otvorili Kontrolni centar."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Vezérlőközpont megnyitásához húzzon lefelé a jobb felső sarokból."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesek ke bawah dari sudut kanan atas untuk membuka Pusat Kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri verso il basso dall’angolo in alto a destra per aprire Centro di Controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上隅から下にスワイプしてコントロールセンターを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오른쪽 상단 모서리에서 아래로 쓸어내려 제어 센터를 여십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret ke bawah dari penjuru kanan atas untuk membuka Pusat Kawalan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sveip ned fra øvre høyre hjørne for å åpne Kontrollsenter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg omlaag vanaf de rechterbovenhoek om het bedieningspaneel te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń w dół od prawego górnego rogu, aby otworzyć Centrum sterowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize para baixo a partir do canto superior direito para abrir a Central de Controle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o dedo para baixo a partir do canto superior direito para abrir o Centro de controlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisați în jos din colțul din dreapta sus pentru a deschide Centrul de control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните вниз от правого верхнего угла, чтобы открыть Пункт управления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím nadol z pravého horného rohu otvorte Ovládacie centrum."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svep nedåt från det övre högra hörnet för att öppna Kontrollcenter."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปัดลงจากมุมขวาบนเพื่อเปิดศูนย์ควบคุม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim Merkezi’ni açmak için sağ üst köşeden aşağı kaydırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проведіть униз від правого верхнього кута, щоб відкрити Центр керування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuốt xuống từ góc trên cùng bên phải để mở Trung tâm điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从右上角向下轻扫以打开控制中心。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從右上角向下滑動來打開「控制中心」。"
          }
        }
      }
    },
    "Swipe down, tap Scan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لأسفل، واضغط على «مسح»."
