    "Links, Wi-Fi, anything. Every phone reads it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روابط، Wi-Fi، أي شيء. يقرؤه كل هاتف."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enllaços, Wi-Fi, el que sigui. Qualsevol telèfon el llegeix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkazy, Wi-Fi, cokoli. Přečte ho každý telefon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, Wi-Fi, hvad som helst. Alle telefoner kan læse den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, Wi-Fi, alles. Jedes Telefon kann ihn lesen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύνδεσμοι, Wi-Fi, οτιδήποτε. Κάθε τηλέφωνο τον διαβάζει."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, Wi-Fi, anything. Every phone reads it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlaces, Wi-Fi, lo que sea. Cualquier teléfono lo lee."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkit, Wi-Fi, mitä tahansa. Jokainen puhelin lukee sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liens, Wi-Fi, tout. Tous les téléphones le lisent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישורים, Wi-Fi, כל דבר. כל טלפון קורא את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक, Wi-Fi, कुछ भी। हर फ़ोन इसे पढ़ लेता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poveznice, Wi-Fi, bilo što. Očitava ga svaki telefon."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkek, Wi-Fi, bármi. Minden telefon beolvassa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan, Wi-Fi, apa saja. Semua ponsel bisa membacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link, Wi-Fi, qualsiasi cosa. Ogni telefono lo legge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクやWi-Fiなど、何でも。どのスマートフォンでも読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크, Wi-Fi 등 무엇이든. 모든 휴대폰에서 읽을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pautan, Wi-Fi, apa sahaja. Semua telefon boleh membacanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lenker, Wi-Fi, hva som helst. Alle telefoner kan lese den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, Wi-Fi, alles. Elke telefoon kan hem lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linki, Wi-Fi, cokolwiek. Odczyta go każdy telefon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, Wi-Fi, qualquer coisa. Todo celular lê."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligações, Wi-Fi, o que quiser. Qualquer telemóvel o lê."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linkuri, Wi-Fi, orice. Orice telefon îl poate citi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылки, Wi-Fi — что угодно. Его прочитает любой телефон."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkazy, Wi-Fi, čokoľvek. Prečíta ho každý telefón."
