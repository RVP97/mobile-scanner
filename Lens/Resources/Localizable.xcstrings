          "stringUnit" : {
            "state" : "translated",
            "value" : "6 cifre (sistemul numeric 0), 7 cu sistemul numeric 0 sau 1, 8 cu cifra de control sau un UPC-A de 12 cifre de scurtat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 цифр (система нумерации 0), 7 — с системой нумерации 0 или 1, 8 — с контрольной цифрой, либо 12-значный UPC-A для сокращения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 číslic (číselný systém 0), 7 s číselným systémom 0 alebo 1, 8 s kontrolnou číslicou alebo 12-ciferný UPC-A na skrátenie."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 siffror (nummersystem 0), 7 med nummersystem 0 eller 1, 8 med kontrollsiffran, eller en 12-siffrig UPC-A som ska kortas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 หลัก (ระบบตัวเลข 0), 7 หลักเมื่อมีระบบตัวเลข 0 หรือ 1, 8 หลักเมื่อรวมเลขตรวจสอบ หรือ UPC-A 12 หลักเพื่อย่อให้สั้นลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 basamak (sayı sistemi 0), 0 veya 1 sayı sistemiyle 7, denetim basamağıyla 8 ya da kısaltılacak 12 basamaklı bir UPC-A."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 цифр (система нумерації 0), 7 — із системою нумерації 0 або 1, 8 — з контрольною цифрою, або 12-значний UPC-A для скорочення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 chữ số (hệ số 0), 7 chữ số với hệ số 0 hoặc 1, 8 chữ số nếu có số kiểm tra, hoặc một mã UPC-A 12 chữ số để rút gọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 位数字（数字系统 0）；带数字系统 0 或 1 时为 7 位；加上校验位为 8 位；也可输入 12 位 UPC-A 进行压缩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 位數字（數字系統 0）、7 位（數字系統 0 或 1）、含檢查碼共 8 位，或可縮短的 12 位 UPC-A。"
          }
        }
      }
    },
