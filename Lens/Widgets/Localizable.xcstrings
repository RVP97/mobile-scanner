    "Collect several codes in a row, then review them together." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجمع عدة رموز متتالية، ثم راجعها معًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recull diversos codis seguits i després revisa’ls junts."
