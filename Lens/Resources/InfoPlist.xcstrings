    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لـ Lunet تذكّر المكان الذي مسحت فيه كل رمز. تبقى المواقع على الـ iPhone."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet pot recordar on has escanejat cada codi. Les ubicacions es queden al teu iPhone."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet si může pamatovat, kde jste který kód naskenovali. Polohy zůstávají na vašem iPhonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet kan huske, hvor du scannede hver kode. Lokaliteterne bliver på din iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet kann sich merken, wo du jeden Code gescannt hast. Standorte bleiben auf deinem iPhone."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Lunet μπορεί να απομνημονεύει πού σαρώσατε κάθε κωδικό. Οι τοποθεσίες παραμένουν στο iPhone σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lunet can remember where you scanned each code. Locations stay on your iPhone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet can remember where you scanned each code. Locations stay on your iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet puede recordar dónde escaneaste cada código. Las ubicaciones se quedan en tu iPhone."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet voi muistaa, missä skannasit kunkin koodin. Sijainnit pysyvät iPhonessasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet peut mémoriser l’endroit où vous avez scanné chaque code. Les positions restent sur votre iPhone."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Lunet יכול לזכור איפה סרקת כל קוד. המיקומים נשארים ב־iPhone שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet याद रख सकता है कि आपने हर कोड कहाँ स्कैन किया। स्थान आपके iPhone पर ही रहते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet može pamtiti gdje ste skenirali svaki kôd. Lokacije ostaju na vašem iPhoneu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lunet megjegyezheti, hol olvasta be az egyes kódokat. A helyadatok az iPhone-on maradnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
