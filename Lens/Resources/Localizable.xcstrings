    "To remember where you scan, allow location access while using Lunet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتذكّر مكان المسح، اسمح بالوصول إلى الموقع أثناء استخدام Lunet."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per recordar on escaneges, permet l’accés a la ubicació mentre fas servir Lunet."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete‑li si pamatovat, kde skenujete, povolte přístup k poloze při používání Lunetu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad adgang til lokalitet, mens du bruger Lunet, for at huske, hvor du scanner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Standortzugriff beim Verwenden von Lunet, damit dein Scanort gemerkt werden kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να απομνημονεύεται πού σαρώνετε, επιτρέψτε την πρόσβαση στην τοποθεσία κατά τη χρήση του Lunet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To remember where you scan, allow location access while using Lunet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para recordar dónde escaneas, permite el acceso a la ubicación mientras usas Lunet."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jotta skannauspaikka muistetaan, salli sijainnin käyttö Lunetia käytettäessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour mémoriser où vous scannez, autorisez l’accès à la position pendant l’utilisation de Lunet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לזכור איפה אתה סורק, אפשר גישה למיקום בזמן השימוש ב־Lunet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप कहाँ स्कैन करते हैं, यह याद रखने के लिए Lunet का उपयोग करते समय स्थान ऐक्सेस की अनुमति दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da bi se pamtilo gdje skenirate, dopustite pristup lokaciji tijekom upotrebe Luneta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A beolvasás helyének megjegyzéséhez engedélyezze a helyhozzáférést a Lunet használata közben."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengingat lokasi pemindaian, izinkan akses lokasi saat menggunakan Lunet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ricordare dove scansioni, consenti l’accesso alla posizione mentre usi Lunet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンした場所を記録するには、Lunetの使用中に位置情報へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔한 위치를 기억하려면 Lunet을 사용하는 동안 위치 접근을 허용하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengingati tempat anda mengimbas, benarkan akses lokasi semasa menggunakan Lunet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å huske hvor du skanner må du tillate tilgang til sted når Lunet er i bruk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta locatietoegang toe tijdens gebruik van Lunet om te onthouden waar je scant."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zapamiętywać miejsca skanowania, zezwól na dostęp do lokalizacji podczas używania Lunet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para lembrar onde você escaneia, permita o acesso à localização durante o uso do Lunet."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para lembrar onde lê os códigos, permita o acesso à localização durante a utilização da Lunet."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a reține unde scanați, permiteți accesul la locație în timpul utilizării Lunet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы запоминать места сканирования, разрешите доступ к местоположению при использовании Lunet."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak si chcete pamätať, kde skenujete, povoľte prístup k polohe počas používania Lunetu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt platsåtkomst när Lunet används för att komma ihåg var du skannar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการจดจำตำแหน่งที่คุณสแกน ให้อนุญาตการเข้าถึงตำแหน่งที่ตั้งขณะใช้ Lunet"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nerede taradığınızı hatırlamak için Lunet’i kullanırken konum erişimine izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб запам’ятовувати місця сканування, дозвольте доступ до розташування під час використання Lunet."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để ghi nhớ nơi bạn quét, hãy cho phép truy cập vị trí khi dùng Lunet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要记住扫描地点，请允许 Lunet 在使用期间访问你的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要記住掃描地點，請允許 Lunet 在使用期間取用位置。"
          }
        }
      }
    },
    "To show where a link really goes, Lunet contacts that link's own server to follow redirects and look up the domain's age. You can turn this off in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لعرض المكان الذي يؤدي إليه الرابط فعلًا، يتصل Lunet بخادم الرابط نفسه لتتبع عمليات إعادة التوجيه ومعرفة عمر النطاق. يمكنك إيقاف ذلك في الإعدادات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrar on porta realment un enllaç, Lunet contacta el servidor del mateix enllaç per seguir les redireccions i consultar l’antiguitat del domini. Pots desactivar-ho a Configuració."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby Lunet ukázal, kam odkaz skutečně vede, kontaktuje přímo server daného odkazu, sleduje přesměrování a zjišťuje stáří domény. Vypnout to můžete v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at vise, hvor et link faktisk fører hen, kontakter Lunet linkets egen server for at følge omdirigeringer og slå domænets alder op. Du kan slå det fra i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um zu zeigen, wohin ein Link wirklich führt, kontaktiert Lunet den Server dieses Links selbst, um Weiterleitungen zu folgen und das Alter der Domain zu ermitteln. Du kannst dies in den Einstellungen deaktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Για να δείξει πού οδηγεί πραγματικά ένας σύνδεσμος, το Lunet επικοινωνεί με τον ίδιο τον διακομιστή του συνδέσμου για να ακολουθήσει τις ανακατευθύνσεις και να βρει την ηλικία του τομέα. Μπορείτε να το απενεργοποιήσετε στις Ρυθμίσεις."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To show where a link really goes, Lunet contacts that link's own server to follow redirects and look up the domain's age. You can turn this off in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar adónde lleva un enlace en realidad, Lunet contacta al propio servidor del enlace para seguir las redirecciones y consultar la antigüedad del dominio. Puedes desactivarlo en Configuración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttääkseen, minne linkki todella johtaa, Lunet ottaa yhteyttä linkin omaan palvelimeen seuratakseen uudelleenohjauksia ja selvittääkseen verkkotunnuksen iän. Voit laittaa tämän pois päältä Asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour montrer où mène vraiment un lien, Lunet contacte le serveur de ce lien afin de suivre les redirections et de vérifier l’âge du domaine. Vous pouvez désactiver cette option dans les réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להראות לאן קישור באמת מוביל, Lunet פונה לשרת של הקישור עצמו כדי לעקוב אחר הפניות ולבדוק את גיל הדומיין. אפשר לכבות זאת ב״הגדרות״."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक असल में कहाँ ले जाता है, यह दिखाने के लिए Lunet रीडायरेक्ट फ़ॉलो करने और डोमेन की उम्र पता करने हेतु उसी लिंक के अपने सर्वर से संपर्क करता है। आप इसे सेटिंग्ज़ में बंद कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kako bi pokazao kamo poveznica zapravo vodi, Lunet se obraća poslužitelju same poveznice radi praćenja preusmjeravanja i provjere starosti domene. To možete isključiti u Postavkama."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hogy megmutassa, valójában hová vezet egy link, a Lunet felveszi a kapcsolatot a link saját szerverével, követi az átirányításokat, és lekérdezi a domain korát. Ezt a Beállításokban kikapcsolhatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menunjukkan ke mana tautan sebenarnya mengarah, Lunet menghubungi server milik tautan itu sendiri untuk mengikuti pengalihan dan mencari tahu usia domain. Anda dapat mematikannya di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per mostrare dove porta davvero un link, Lunet contatta il server del link stesso per seguire i reindirizzamenti e verificare l’età del dominio. Puoi disattivare questa opzione in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクの本当の行き先を表示するため、Lunetはリンク先のサーバに直接問い合わせて、リダイレクトをたどり、ドメインの登録からの期間を調べます。この機能は設定でオフにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크가 실제로 어디로 연결되는지 보여주기 위해 Lunet은 해당 링크 자체의 서버에 연결하여 리디렉션을 추적하고 도메인 연령을 조회합니다. 설정에서 끌 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menunjukkan ke mana pautan sebenarnya menuju, Lunet menghubungi pelayan pautan itu sendiri untuk mengikut ubah hala dan menyemak usia domain. Anda boleh mematikannya dalam Seting."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å vise hvor en lenke egentlig fører, kontakter Lunet lenkens egen server for å følge omdirigeringer og slå opp domenets alder. Du kan slå dette av i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om te laten zien waar een link echt naartoe gaat, maakt Lunet contact met de server van die link zelf om omleidingen te volgen en de leeftijd van het domein op te zoeken. Je kunt dit uitschakelen bij Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby pokazać, dokąd naprawdę prowadzi link, Lunet łączy się z serwerem tego linku, aby śledzić przekierowania i ustalić wiek domeny. Możesz to wyłączyć w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar para onde um link realmente leva, o Lunet entra em contato com o próprio servidor do link para seguir os redirecionamentos e consultar a idade do domínio. Você pode desativar isso em Ajustes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar para onde uma ligação leva realmente, a Lunet contacta o próprio servidor da ligação para seguir os redirecionamentos e consultar a idade do domínio. Pode desativar isto em Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru a arăta unde duce de fapt un link, Lunet contactează serverul propriu al linkului pentru a urmări redirecționările și a afla vechimea domeniului. Puteți dezactiva această opțiune în Configurări."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы показать, куда на самом деле ведет ссылка, Lunet обращается к серверу самой ссылки, чтобы отследить перенаправления и узнать возраст домена. Это можно выключить в Настройках."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby Lunet ukázal, kam odkaz naozaj vedie, kontaktuje vlastný server odkazu, sleduje presmerovania a zisťuje vek domény. Môžete to vypnúť v Nastaveniach."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att visa vart en länk egentligen leder kontaktar Lunet länkens egen server för att följa omdirigeringar och ta reda på domänens ålder. Du kan stänga av detta i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพื่อแสดงว่าลิงก์พาไปที่ไหนจริงๆ Lunet จะติดต่อเซิร์ฟเวอร์ของลิงก์นั้นโดยตรงเพื่อติดตามการเปลี่ยนเส้นทางและค้นหาอายุของโดเมน คุณสามารถปิดได้ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir bağlantının gerçekte nereye gittiğini göstermek için Lunet, yönlendirmeleri izlemek ve alan adının yaşını öğrenmek üzere o bağlantının kendi sunucusuyla iletişim kurar. Bunu Ayarlar’dan kapatabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб показати, куди насправді веде посилання, Lunet звертається до сервера самого посилання, щоб відстежити переспрямування та дізнатися вік домену. Це можна вимкнути в Параметрах."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để cho biết liên kết thực sự dẫn đến đâu, Lunet liên hệ chính máy chủ của liên kết đó để lần theo các chuyển hướng và tra cứu tuổi của tên miền. Bạn có thể tắt tính năng này trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了显示链接真正指向何处，Lunet 会直接联系链接所在的服务器，跟踪重定向并查询域名的注册时长。你可以在设置中关闭此功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了顯示連結真正連到哪裡，Lunet 會聯絡該連結本身的伺服器，以追蹤重新導向並查詢網域註冊時間。你可以在「設定」中關閉此功能。"
          }
        }
      }
    },
