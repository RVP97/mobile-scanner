    "Keep a code you made one glance away, ready to be scanned." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل رمزًا أنشأته في متناول نظرة، جاهزًا للمسح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingues un codi que has creat sempre a la vista, a punt per escanejar-lo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mějte vytvořený kód na dohled, připravený k naskenování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hav en kode, du har lavet, lige ved hånden, klar til at blive scannet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte einen selbst erstellten Code im Blick, bereit zum Scannen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχετε έναν κωδικό που φτιάξατε μια ματιά μακριά, έτοιμο για σάρωση."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a code you made one glance away, ready to be scanned."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten un código que creaste siempre a la vista, listo para escanearse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä luomasi koodi aina näkyvillä ja valmiina skannattavaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez un code que vous avez créé sous les yeux, prêt à être scanné."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קוד שיצרת, תמיד במרחק מבט, מוכן לסריקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना बनाया कोड हमेशा नज़र के सामने रखें, स्कैन के लिए तैयार।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neka kôd koji ste izradili bude uvijek na dohvat pogleda, spreman za skeniranje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy saját kód mindig szem előtt, beolvasásra készen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan kode buatan Anda agar selalu terlihat, siap dipindai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni un codice che hai creato sempre a portata di sguardo, pronto per essere scansionato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作成したコードをすぐ見られる場所に置いて、いつでもスキャンできるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 만든 코드를 한눈에 볼 수 있게 두어 바로 스캔할 수 있도록 하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
