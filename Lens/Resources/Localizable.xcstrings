            "value" : "بعض الحروف تشبه الاسم الحقيقي فقط في الشكل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunes lletres només s’assemblen al nom real."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Některá písmena jen vypadají jako skutečný název."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle bogstaver ligner kun det rigtige navn."
