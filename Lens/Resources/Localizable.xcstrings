        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi Face ID o il codice prima che qualcuno possa vedere le tue scansioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
