          }
        }
      }
    },
    "To show where a link really goes, Lunet contacts that link's own server to follow redirects and look up the domain's age. You can turn this off in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mostrar adónde lleva un enlace en realidad, Lunet contacta al propio servidor del enlace para seguir las redirecciones y consultar la antigüedad del dominio. Puedes desactivarlo en Configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour montrer où mène vraiment un lien, Lunet contacte le serveur de ce lien afin de suivre les redirections et de vérifier l’âge du domaine. Vous pouvez désactiver cette option dans les réglages."
          }
        }
