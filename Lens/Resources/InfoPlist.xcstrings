          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Lunet pode lembrar onde você escaneou cada código. As localizações ficam no seu iPhone."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Lunet pode lembrar onde leu cada código. As localizações ficam no iPhone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunet poate reține unde ați scanat fiecare cod. Locațiile rămân pe iPhone."
