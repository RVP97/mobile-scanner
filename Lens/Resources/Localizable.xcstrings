    "A logo keeps a clear zone around it and switches error correction to High, so the code still reads." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ الشعار بمنطقة فارغة حوله ويحوّل تصحيح الأخطاء إلى «مرتفع»، لتظل قراءة الرمز ممكنة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un logotip deixa una zona lliure al voltant i passa la correcció d’errors a Alta, perquè el codi es continuï llegint."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logo si kolem sebe ponechává volnou zónu a přepne opravu chyb na Vysokou, takže kód půjde dál přečíst."
          }
        },
        "da" : {
          "stringUnit" : {
