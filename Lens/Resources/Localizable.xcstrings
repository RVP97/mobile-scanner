    "Letters from different alphabets can imitate a familiar name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لحروف من أبجديات مختلفة أن تنتحل اسمًا مألوفًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lletres d’alfabets diferents poden imitar un nom conegut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Písmena z různých abeced mohou napodobit známý název."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bogstaver fra forskellige alfabeter kan efterligne et kendt navn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buchstaben aus verschiedenen Alphabeten können einen bekannten Namen imitieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Γράμματα από διαφορετικά αλφάβητα μπορούν να μιμηθούν ένα γνωστό όνομα."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letters from different alphabets can imitate a familiar name."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las letras de distintos alfabetos pueden imitar un nombre conocido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eri aakkostojen kirjaimet voivat jäljitellä tuttua nimeä."
          }
        },
        "fr" : {
          "stringUnit" : {
