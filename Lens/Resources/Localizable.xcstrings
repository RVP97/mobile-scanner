    "That “%@” is a Cyrillic letter, not a Latin “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That “%1$@” is a Cyrillic letter, not a Latin “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa “%1$@” es una letra cirílica, no una “%2$@” latina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce « %1$@ » est une lettre cyrillique, pas un « %2$@ » latin."
          }
        }
      }
    },
    "That “%@” is a Greek letter, not a Latin “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That “%1$@” is a Greek letter, not a Latin “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa “%1$@” es una letra griega, no una “%2$@” latina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce « %1$@ » est une lettre grecque, pas un « %2$@ » latin."
          }
        }
      }
    },
    "That “%@” only looks like “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That “%1$@” only looks like “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa “%1$@” solo se parece a “%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce « %1$@ » ne fait que ressembler à « %2$@ »."
          }
        }
      }
    },
    "That's a zero, not the letter “o”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso es un cero, no la letra “o”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est un zéro, pas la lettre « o »."
          }
        }
      }
    },
    "That's the number %@, not the letter “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That's the number %1$@, not the letter “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese es el número %1$@, no la letra “%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le chiffre %1$@, pas la lettre « %2$@ »."
          }
        }
      }
    },
    "That's the number one, not the letter “l”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese es el número uno, no la letra “l”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le chiffre un, pas la lettre « l »."
          }
        }
      }
    },
    "That's too long for %@. Keep it under %lld characters." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That's too long for %1$@. Keep it under %2$lld characters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es demasiado largo para %1$@. Usa menos de %2$lld caracteres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est trop long pour %1$@. Restez sous %2$lld caractères."
          }
        }
      }
    },
    "That's too long for a Data Matrix code. Try a QR code instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es demasiado largo para un código Data Matrix. Prueba mejor con un código QR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est trop long pour un code Data Matrix. Essayez plutôt un code QR."
          }
        }
      }
    },
    "That's “%@”, not the letter “%@”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "That's “%1$@”, not the letter “%2$@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso es “%1$@”, no la letra “%2$@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est « %1$@ », pas la lettre « %2$@ »."
          }
        }
      }
    },
    "The destination is hidden until it opens." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino está oculto hasta que se abre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destination reste cachée jusqu’à l’ouverture."
          }
        }
      }
    },
    "The event ends before it starts." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El evento termina antes de empezar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’événement se termine avant de commencer."
          }
        }
      }
    },
    "The fastest scan is the one where you never look for the app. Put Lunet where your thumb already is." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escaneo más rápido es el que no te obliga a buscar la app. Pon Lunet donde ya está tu pulgar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scan le plus rapide, c’est celui où l’on ne cherche pas l’app. Placez Lunet là où se trouve déjà votre pouce."
          }
        }
      }
    },
    "The last digit should be %lld — it's the check digit." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último dígito debería ser %lld: es el dígito verificador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dernier chiffre devrait être %lld : c’est la clé de contrôle."
          }
        }
      }
    },
    "The logo covers too much of the code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El logo cubre demasiado del código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le logo couvre une trop grande partie du code."
          }
        }
      }
    },
    "The password hides again when you close this." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña se vuelve a ocultar al cerrar esto."
